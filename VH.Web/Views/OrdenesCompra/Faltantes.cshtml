@model IEnumerable<VH.Services.DTOs.FaltanteDto>
@using Microsoft.AspNetCore.Mvc.Rendering
@using VH.Web.Extensions
@{
    ViewData["Title"] = "Faltantes por surtir";
    var almacenes = ViewBag.Almacenes as List<SelectListItem> ?? new();
    var proveedores = ViewBag.Proveedores as List<SelectListItem> ?? new();
    var lista = Model?.ToList() ?? new List<VH.Services.DTOs.FaltanteDto>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-clipboard-plus text-primary me-2"></i>Faltantes por surtir
            </h2>
            <p class="text-muted mb-0">Lo que piden las requisiciones autorizadas y no hay en el almacén</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul me-2"></i>Órdenes emitidas
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtro por obra -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold mb-1">Almacén</label>
                    <select name="idAlmacen" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Todos los almacenes --</option>
                        @foreach (var a in almacenes)
                        {
                            <option value="@a.Value" selected="@(ViewBag.FiltroAlmacen?.ToString() == a.Value)">@a.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-8 text-md-end">
                    <span class="badge bg-secondary fs-6">@lista.Count material(es) por comprar</span>
                </div>
            </form>
        </div>
    </div>

    @if (!lista.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle display-4 text-success"></i>
                <h5 class="mt-3">No hay faltantes</h5>
                <p class="text-muted mb-0">
                    Todo lo autorizado se puede surtir del almacén o ya está pedido a un proveedor.
                </p>
            </div>
        </div>
    }
    else
    {
        <form asp-action="Generar" method="post" id="formOrden">
            @Html.AntiForgeryToken()

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width:44px;" class="ps-3">
                                        <input type="checkbox" class="form-check-input" id="chkTodos" title="Seleccionar todo">
                                    </th>
                                    <th>Material</th>
                                    <th>Almacén destino</th>
                                    <th class="text-center">Piden</th>
                                    <th class="text-center">Disponible</th>
                                    <th class="text-center">En camino</th>
                                    <th class="text-center">Faltan</th>
                                    <th class="text-end">Precio ref.</th>
                                    <th class="text-end">Importe</th>
                                    <th>Esperan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < lista.Count; i++)
                                {
                                    var f = lista[i];
                                    <tr>
                                        <td class="ps-3">
                                            <input type="checkbox" class="form-check-input chk-linea" data-idx="@i" checked>
                                            <input type="hidden" name="Lineas[@i].IdMaterial" value="@f.IdMaterial" />
                                            <input type="hidden" name="Lineas[@i].IdAlmacenDestino" value="@f.IdAlmacen" />
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@f.NombreMaterial</span>
                                            <br /><small class="text-muted">@f.UnidadMedida</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info">
                                                <i class="bi bi-box-seam me-1"></i>@f.NombreAlmacen
                                            </span>
                                            @if (!string.IsNullOrEmpty(f.NombreProyecto))
                                            {
                                                <br /><small class="text-muted">@f.NombreProyecto</small>
                                            }
                                        </td>
                                        <td class="text-center">@f.Demanda.FormatoCantidad()</td>
                                        <td class="text-center text-muted">@f.Disponible.FormatoCantidad()</td>
                                        <td class="text-center text-muted">
                                            @(f.EnTransito > 0 ? f.EnTransito.FormatoCantidad() : "-")
                                        </td>
                                        <td class="text-center">
                                            <input type="number" name="Lineas[@i].Cantidad" value="@f.Faltante"
                                                   class="form-control form-control-sm text-center cantidad-linea"
                                                   step="0.01" min="0.01" style="width:90px; margin:auto;"
                                                   data-idx="@i" oninput="recalcular()">
                                        </td>
                                        <td class="text-end">
                                            <div class="input-group input-group-sm" style="width:120px; margin-left:auto;">
                                                <span class="input-group-text">$</span>
                                                <input type="number" name="Lineas[@i].PrecioUnitario" value="@f.UltimoPrecio"
                                                       class="form-control text-end precio-linea"
                                                       step="0.01" min="0.01" data-idx="@i" oninput="recalcular()">
                                            </div>
                                            @if (!string.IsNullOrEmpty(f.UltimoProveedor))
                                            {
                                                <small class="text-muted d-block">@f.UltimoProveedor</small>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold" id="importe_@i">
                                            @((f.Faltante * f.UltimoPrecio).ToString("C2"))
                                        </td>
                                        <td>
                                            @foreach (var r in f.Renglones)
                                            {
                                                <div class="small">
                                                    <span class="fw-semibold">@r.NombreEmpleado</span>
                                                    <span class="text-muted">· @r.NumeroRequisicion</span>
                                                    @if (r.DiasEspera > 0)
                                                    {
                                                        <span class="badge bg-@(r.DiasEspera >= 7 ? "danger" : "secondary")-subtle text-@(r.DiasEspera >= 7 ? "danger" : "secondary") ms-1">
                                                            @r.DiasEspera d
                                                        </span>
                                                    }
                                                    @if (r.EsUrgente)
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning ms-1">urgente</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row justify-content-end">
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="mb-0"><i class="bi bi-send me-2"></i>Emitir orden de compra</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Proveedor <span class="text-danger">*</span></label>
                                <select name="IdProveedor" class="form-select form-select-lg" required>
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var p in proveedores)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Entrega estimada</label>
                                <input type="date" name="FechaEntregaEstimada" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Observaciones</label>
                                <input name="Observaciones" class="form-control" maxlength="500"
                                       placeholder="Condiciones, referencia de cotización..." />
                            </div>

                            <hr />
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Materiales seleccionados</span>
                                <span class="fw-semibold" id="lblLineas">@lista.Count</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold fs-5">Total estimado</span>
                                <span class="fw-bold fs-5 text-success" id="lblTotal">$0.00</span>
                            </div>

                            <div class="alert alert-info small mt-3 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Al emitirla, estos materiales salen de la bandeja y no se podrán
                                volver a pedir hasta que la orden se reciba o se cancele.
                            </div>
                        </div>
                        <div class="card-footer bg-white py-3">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-check-lg me-2"></i>Emitir orden de compra
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Las líneas sin marcar se deshabilitan para que no viajen en el POST.
        function aplicarSeleccion() {
            document.querySelectorAll('.chk-linea').forEach(chk => {
                const i = chk.dataset.idx;
                const fila = chk.closest('tr');
                fila.querySelectorAll('input[type=hidden], .cantidad-linea, .precio-linea').forEach(inp => {
                    inp.disabled = !chk.checked;
                });
                fila.classList.toggle('opacity-50', !chk.checked);
            });
            recalcular();
        }

        function recalcular() {
            let total = 0;
            let lineas = 0;
            document.querySelectorAll('.chk-linea').forEach(chk => {
                const i = chk.dataset.idx;
                const cant = parseFloat(document.querySelector(`.cantidad-linea[data-idx="${i}"]`)?.value) || 0;
                const precio = parseFloat(document.querySelector(`.precio-linea[data-idx="${i}"]`)?.value) || 0;
                const importe = cant * precio;
                document.getElementById(`importe_${i}`).textContent =
                    '$' + importe.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (chk.checked) { total += importe; lineas++; }
            });
            document.getElementById('lblLineas').textContent = lineas;
            document.getElementById('lblTotal').textContent =
                '$' + total.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        document.querySelectorAll('.chk-linea').forEach(chk =>
            chk.addEventListener('change', aplicarSeleccion));

        document.getElementById('chkTodos')?.addEventListener('change', function () {
            document.querySelectorAll('.chk-linea').forEach(c => c.checked = this.checked);
            aplicarSeleccion();
        });

        aplicarSeleccion();
    </script>
}
