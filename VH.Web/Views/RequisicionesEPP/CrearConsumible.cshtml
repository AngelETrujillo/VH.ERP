@model VH.Services.DTOs.RequisicionEPPRequestDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Pedir consumible de obra";
    var obras = ViewBag.Obras as List<SelectListItem> ?? new();
    var materiales = ViewBag.Materiales as List<SelectListItem> ?? new();
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Create" class="btn btn-outline-secondary me-3" title="Cambiar de tipo">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-bricks text-warning me-2"></i>Consumible de obra
            </h2>
            <p class="text-muted mb-0">Se carga a la obra o a una partida. Nadie firma por él.</p>
        </div>
    </div>

    @if (!materiales.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No hay materiales de tipo <strong>Consumible</strong> activos en el catálogo.
        </div>
    }

    <form asp-action="Create" method="post" id="formRequisicion">
        <input type="hidden" name="tipo" value="@((int)VH.Services.Entities.TipoMaterial.Consumible)" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_RequisicionCabecera" model="Model" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-warning py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Qué se pide, y a qué se carga</h5>
                <button type="button" class="btn btn-dark btn-sm fw-semibold" id="btnAgregar">
                    <i class="bi bi-plus-lg me-1"></i>Agregar material
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3" style="min-width:210px;">Obra <span class="text-danger">*</span></th>
                                <th style="min-width:230px;">Partida</th>
                                <th style="min-width:210px;">Material <span class="text-danger">*</span></th>
                                <th style="width:130px;">Cantidad <span class="text-danger">*</span></th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTabla"></tbody>
                    </table>
                </div>

                <div class="text-center py-5 text-muted" id="vacio">
                    <i class="bi bi-inbox display-5"></i>
                    <p class="mt-2 mb-0">Agregue al menos un material</p>
                </div>

                <div class="alert alert-warning m-3 d-none" id="avisoVacio" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>Agregue al menos un material antes de guardar.
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="alert alert-secondary">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>La partida es opcional, pero conviene.</strong> Cargándolo sólo
                    a la obra queda registrado el consumo; cargándolo a una partida se puede
                    comparar después contra lo que se presupuestó para ese concepto.
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 bg-light mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Renglones</span>
                            <span class="fw-semibold" id="lblRenglones">0</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Obras</span>
                            <span class="fw-semibold" id="lblObras">0</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-warning btn-lg px-5">
                        <i class="bi bi-check-lg me-2"></i>Enviar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const OBRAS = @Html.Raw(Json.Serialize(obras.Select(o => new { v = o.Value, t = o.Text })));
        const MATERIALES = @Html.Raw(Json.Serialize(materiales.Select(m => new { v = m.Value, t = m.Text })));

        let contador = 0;

        // Las partidas de cada obra se piden al elegirla, no se traen todas de
        // golpe: el presupuesto entero para usar tres renglones no tiene sentido.
        const cachePartidas = new Map();

        async function partidasDe(idObra) {
            if (cachePartidas.has(idObra)) return cachePartidas.get(idObra);
            try {
                const r = await fetch(`/RequisicionesEPP/PartidasDeObra?idProyecto=${idObra}`);
                const datos = r.ok ? await r.json() : [];
                cachePartidas.set(idObra, datos);
                return datos;
            } catch {
                return [];
            }
        }

        function opciones(lista, vacio) {
            return `<option value="">${vacio}</option>` +
                lista.map(o => `<option value="${o.v}">${o.t}</option>`).join('');
        }

        function agregarRenglon() {
            const i = contador++;
            const fila = document.createElement('tr');
            fila.id = `fila${i}`;
            fila.innerHTML = `
                <td class="ps-3">
                    <select name="Detalles[${i}].IdProyectoDestino" required data-idx="${i}"
                            class="form-select form-select-sm js-obra">${opciones(OBRAS, '-- Seleccionar --')}</select>
                </td>
                <td>
                    <select name="Detalles[${i}].IdConceptoPartida" id="partida${i}"
                            class="form-select form-select-sm" disabled>
                        <option value="">Elija la obra primero</option>
                    </select>
                </td>
                <td>
                    <select name="Detalles[${i}].IdMaterial" required
                            class="form-select form-select-sm">${opciones(MATERIALES, '-- Seleccionar --')}</select>
                </td>
                <td>
                    <input type="number" name="Detalles[${i}].CantidadSolicitada" value="1"
                           step="0.01" min="0.01" required class="form-control form-control-sm">
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="eliminarRenglon(${i})" title="Quitar">
                        <i class="bi bi-x"></i>
                    </button>
                </td>`;

            document.getElementById('cuerpoTabla').appendChild(fila);
            actualizarResumen();
        }

        function eliminarRenglon(i) {
            document.getElementById(`fila${i}`)?.remove();
            actualizarResumen();
        }

        function actualizarResumen() {
            const filas = document.querySelectorAll('#cuerpoTabla tr');
            document.getElementById('lblRenglones').textContent = filas.length;

            const obras = new Set();
            document.querySelectorAll('[name$=".IdProyectoDestino"]').forEach(s => {
                if (s.value) obras.add(s.value);
            });
            document.getElementById('lblObras').textContent = obras.size;
            document.getElementById('vacio').classList.toggle('d-none', filas.length > 0);
        }

        document.getElementById('cuerpoTabla').addEventListener('change', async function (e) {
            const sel = e.target.closest('.js-obra');
            if (sel) {
                const partida = document.getElementById(`partida${sel.dataset.idx}`);
                partida.disabled = true;
                partida.innerHTML = '<option value="">Cargando…</option>';

                if (!sel.value) {
                    partida.innerHTML = '<option value="">Elija la obra primero</option>';
                } else {
                    const lista = await partidasDe(sel.value);
                    partida.innerHTML = lista.length
                        ? opciones(lista, '-- Sin partida: se carga a la obra --')
                        : '<option value="">Esta obra no tiene partidas</option>';
                    partida.disabled = lista.length === 0;
                }
            }
            actualizarResumen();
        });

        document.getElementById('btnAgregar').addEventListener('click', agregarRenglon);

        document.getElementById('formRequisicion').addEventListener('submit', function (e) {
            if (!document.querySelectorAll('#cuerpoTabla tr').length) {
                e.preventDefault();
                document.getElementById('avisoVacio').classList.remove('d-none');
            }
        });

        agregarRenglon();
    </script>
}
