@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.ProyectoResponseDto>
@{
    bool? filtroActivo = ViewBag.FiltroActivo;
    ViewData["BuscarPlaceholder"] = "Buscar por nombre o tipo de obra…";
}

@{
    ViewData["Title"] = "Proyectos";
    var esSuperAdmin = User.IsInRole("SuperAdmin");
    var puedeCrear = PermisoHelper.PuedeCrear(Context.Session, "PROYECTOS", esSuperAdmin);
    var puedeEditar = PermisoHelper.PuedeEditar(Context.Session, "PROYECTOS", esSuperAdmin);
    var puedeEliminar = PermisoHelper.PuedeEliminar(Context.Session, "PROYECTOS", esSuperAdmin);
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-building text-primary me-2"></i>Gestión de Proyectos
            </h2>
            <p class="text-muted mb-0">Administra las obras y proyectos de construcción</p>
        </div>
        @if (puedeCrear)
        {
            @if (Html.PuedeCrear("PROYECTOS"))
            {
                <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Proyecto
                </a>
            }
        }
    </div>

    <!-- Alertas -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Card principal -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-lg-7">
                    @await Html.PartialAsync("_BarraBusqueda", Model)
                </div>
                <div class="col-lg-5 text-lg-end">
                    <span class="badge bg-secondary">@Model.Total proyecto(s)</span>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo de Obra</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin Est.</th>
                            <th class="text-end">Presupuesto Total</th>
                            <th class="text-end">Presupuesto EPP/Mes</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Renglones)
                        {
                            <tr>
                                <td><strong>@item.Nombre</strong></td>
                                <td>
                                    <span class="badge bg-info">@item.TipoObra</span>
                                </td>
                                <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.FechaFinEstimada.HasValue)
                                    {
                                        @item.FechaFinEstimada.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">@item.PresupuestoTotal.ToString("C2")</td>
                                <td class="text-end">
                                    @if (item.PresupuestoEPPMensual.HasValue)
                                    {
                                        @item.PresupuestoEPPMensual.Value.ToString("C2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    @if (Html.PuedeEditar("PROYECTOS"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IdProyecto" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.IdProyecto" class="btn btn-sm btn-outline-info" title="Ver">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (Html.PuedeEliminar("PROYECTOS"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.IdProyecto" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Paginador", Model)
        </div>
    </div>
</div>

<style>
    .icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .table > tbody > tr:hover {
        background-color: #f8f9fa;
    }

    .btn-group-sm > .btn {
        padding: 0.4rem 0.6rem;
    }
</style>

@section Scripts {
    <script>
        // Buscar y filtrar los hace el servidor. Queda sólo devolver el foco al
        // campo, para corregir el texto sin volver a tomar el ratón.
        (function () {
            const campo = document.getElementById('campoBuscar');
            if (campo && campo.value) {
                campo.focus();
                campo.setSelectionRange(campo.value.length, campo.value.length);
            }
        })();
        });
    </script>
}