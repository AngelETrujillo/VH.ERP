@model VH.Services.DTOs.CompraEPPResponseDto
@using VH.Web.Extensions
@{
    ViewData["Title"] = "Cancelar Compra";
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-exclamation-triangle text-danger me-2"></i>Cancelar Compra
            </h2>
            <p class="text-muted mb-0">Esta acción devuelve las existencias al estado anterior</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>
                        @(string.IsNullOrEmpty(Model.NumeroDocumento) ? $"Compra #{Model.IdCompra}" : Model.NumeroDocumento)
                    </h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted fw-normal">Proveedor</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.NombreProveedor</dd>

                        <dt class="col-sm-4 text-muted fw-normal">Fecha</dt>
                        <dd class="col-sm-8">@Model.FechaCompra.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 text-muted fw-normal">Total</dt>
                        <dd class="col-sm-8 fw-bold text-success">@Model.Total.ToString("C2")</dd>
                    </dl>

                    <h6 class="fw-semibold mb-3">Materiales que se darán de baja</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th>Material</th>
                                    <th>Almacén</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-center">Disponible</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Detalles)
                                {
                                    <tr>
                                        <td>@d.NombreMaterial</td>
                                        <td><small class="text-muted">@d.NombreAlmacen</small></td>
                                        <td class="text-center">@d.Cantidad.FormatoCantidad()</td>
                                        <td class="text-center">
                                            @if (d.CantidadDisponible == d.Cantidad)
                                            {
                                                <span class="badge bg-success-subtle text-success">Intacto</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">
                                                    Consumido @((d.Cantidad - d.CantidadDisponible).FormatoCantidad())
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.PuedeCancelarse)
                    {
                        <div class="alert alert-danger mt-3">
                            <i class="bi bi-x-circle me-2"></i>
                            <strong>No se puede cancelar.</strong> Ya se entregó material de esta compra.
                            Cancelarla dejaría entregas sin lote de origen.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Se eliminarán los @Model.TotalRenglones renglones y se restarán
                            @Model.TotalUnidades.FormatoCantidad() unidades de las existencias.
                        </div>
                    }
                </div>
                <div class="card-footer bg-light d-flex justify-content-end gap-3 py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-lg me-2"></i>Volver
                    </a>
                    @if (Model.PuedeCancelarse)
                    {
                        <form asp-action="Delete" asp-route-id="@Model.IdCompra" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>Sí, cancelar la compra
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
