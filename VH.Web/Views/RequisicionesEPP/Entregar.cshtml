@model VH.Services.DTOs.RequisicionEPPResponseDto
@using Microsoft.AspNetCore.Mvc.Rendering
@using VH.Web.Extensions
@{
    ViewData["Title"] = $"Entregar {Model.NumeroRequisicion}";
    var idEmpleado = (int)ViewBag.IdEmpleadoDestino;
    var pendientes = ViewBag.EmpleadosPendientes as List<int> ?? new();
    var lotes = ViewBag.LotesDisponibles as Dictionary<int, List<SelectListItem>> ?? new();

    // Sólo lo que recibe esta persona: cada firma ampara únicamente lo suyo.
    var renglones = Model.Detalles
        .Where(d => d.IdEmpleadoDestino == idEmpleado && d.EstadoRenglon == VH.Services.Entities.EstadoRenglonRequisicion.Autorizado)
        .ToList();

    var empleado = renglones.FirstOrDefault();
    var nombreEmpleado = empleado?.NombreEmpleadoDestino ?? "Trabajador";
    var nominaEmpleado = empleado?.NumeroNominaDestino ?? "";
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Details" asp-route-id="@Model.IdRequisicion" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-clipboard-check text-success me-2"></i>Entregar material
            </h2>
            <p class="text-muted mb-0">@Model.NumeroRequisicion · @Model.NombreAlmacen</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (pendientes.Count > 1)
    {
        <div class="alert alert-info d-flex align-items-center">
            <i class="bi bi-people me-2"></i>
            <div>
                Esta requisición tiene material para <strong>@pendientes.Count trabajadores</strong>.
                Se surte de uno en uno, y cada quien firma lo que recibe.
                Está atendiendo a <strong>@nombreEmpleado</strong>.
            </div>
        </div>
    }

    <form asp-action="Entregar" asp-route-id="@Model.IdRequisicion" method="post" id="formEntrega">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdEmpleado" value="@idEmpleado" />

        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Quién recibe -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Recibe</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle bg-success-subtle text-success me-3">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">@nombreEmpleado</h5>
                                <small class="text-muted">Nómina @nominaEmpleado</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Materiales de esta persona -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-box-seam me-2"></i>Material a entregar
                            <span class="badge bg-secondary ms-2">@renglones.Count</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3">Material</th>
                                        <th class="text-center">Solicitado</th>
                                        <th style="min-width:260px;">Lote de salida <span class="text-danger">*</span></th>
                                        <th style="width:130px;">A entregar <span class="text-danger">*</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < renglones.Count; i++)
                                    {
                                        var d = renglones[i];
                                        var lotesMaterial = lotes.ContainsKey(d.IdMaterial) ? lotes[d.IdMaterial] : new List<SelectListItem>();
                                        <tr>
                                            <td class="ps-3">
                                                <span class="fw-semibold">@d.NombreMaterial</span>
                                                <br />
                                                <small class="text-muted">
                                                    @d.UnidadMedida
                                                    @if (!string.IsNullOrEmpty(d.TallaSolicitada) && d.TallaSolicitada != "-")
                                                    {
                                                        <span>· Talla @d.TallaSolicitada</span>
                                                    }
                                                </small>
                                                <input type="hidden" name="Detalles[@i].IdRequisicionDetalle" value="@d.IdRequisicionDetalle" />
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary fs-6">@d.CantidadSolicitada.FormatoCantidad()</span>
                                            </td>
                                            <td>
                                                @if (lotesMaterial.Any())
                                                {
                                                    <select name="Detalles[@i].IdCompraDetalle" class="form-select form-select-sm" required>
                                                        <option value="">-- Seleccionar lote --</option>
                                                        @foreach (var l in lotesMaterial)
                                                        {
                                                            <option value="@l.Value">@l.Text</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Sin existencia en este almacén
                                                    </span>
                                                    <input type="hidden" name="Detalles[@i].IdCompraDetalle" value="0" />
                                                }
                                            </td>
                                            <td>
                                                <input type="number" name="Detalles[@i].CantidadEntregada"
                                                       class="form-control form-control-sm"
                                                       step="0.01" min="0.01"
                                                       max="@d.CantidadSolicitada"
                                                       value="@d.CantidadSolicitada"
                                                       required @(lotesMaterial.Any() ? "" : "disabled") />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Firma -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-dark text-white py-3">
                        <h5 class="mb-0"><i class="bi bi-pen me-2"></i>Firma de @nombreEmpleado</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small">
                            La firma constituye el comprobante de entrega de este material a esta persona.
                        </p>
                        <div class="border rounded bg-white" style="touch-action:none;">
                            <canvas id="canvasFirma" style="width:100%; height:200px; display:block; cursor:crosshair;"></canvas>
                        </div>
                        <input type="hidden" name="FirmaDigital" id="inputFirma" />
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted" id="avisoFirma">Firme dentro del recuadro</small>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLimpiar">
                                <i class="bi bi-eraser me-1"></i>Limpiar
                            </button>
                        </div>

                        <div class="mt-3">
                            <label for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                            <input name="Observaciones" id="Observaciones" class="form-control" maxlength="500"
                                   placeholder="Notas de la entrega..." />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Estado del documento -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="mb-0 fw-semibold"><i class="bi bi-people me-2"></i>Trabajadores del documento</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var grupo in Model.Detalles.Where(d => d.IdEmpleadoDestino.HasValue)
                                        .GroupBy(d => new { d.IdEmpleadoDestino, d.NombreEmpleadoDestino }))
                            {
                                // Con material que llega en partes una persona firma
                                // varias veces, así que haber firmado ya no significa
                                // que haya terminado: lo que cuenta es si le queda
                                // algo por recibir.
                                var yaFirmo = grupo.All(d => d.Entregado);
                                var firmasPrevias = Model.Entregas.Count(e => e.IdEmpleado == grupo.Key.IdEmpleadoDestino);
                                var esActual = grupo.Key.IdEmpleadoDestino == idEmpleado;
                                <li class="list-group-item d-flex justify-content-between align-items-center @(esActual ? "bg-success-subtle" : "")">
                                    <div>
                                        <span class="fw-semibold small">@grupo.Key.NombreEmpleadoDestino</span>
                                        <br />
                                        <small class="text-muted">
                                            @grupo.Count(d => d.Entregado) de @grupo.Count() material(es)
                                            @if (firmasPrevias > 0 && !yaFirmo)
                                            {
                                                <span>&middot; firmó @firmasPrevias vez(ces)</span>
                                            }
                                        </small>
                                    </div>
                                    @if (yaFirmo)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg"></i> Completo</span>
                                    }
                                    else if (esActual)
                                    {
                                        <span class="badge bg-primary">Atendiendo</span>
                                    }
                                    else
                                    {
                                        <a asp-action="Entregar" asp-route-id="@Model.IdRequisicion"
                                           asp-route-idEmpleado="@grupo.Key.IdEmpleadoDestino"
                                           class="badge bg-secondary text-decoration-none">Pendiente</a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg" id="btnGuardar">
                        <i class="bi bi-check-lg me-2"></i>Registrar entrega y firma
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.IdRequisicion" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                </div>

                <div class="alert alert-warning mt-3 small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Se registrará únicamente el material de @nombreEmpleado. El resto del
                    documento queda pendiente hasta que sus destinatarios firmen.
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Firma a mano alzada. El trazo se guarda como PNG en el campo oculto.
        (function () {
            const canvas = document.getElementById('canvasFirma');
            const ctx = canvas.getContext('2d');
            const input = document.getElementById('inputFirma');
            const aviso = document.getElementById('avisoFirma');
            let dibujando = false;
            let hayTrazo = false;

            function ajustarTamano() {
                const ratio = window.devicePixelRatio || 1;
                const ancho = canvas.offsetWidth;
                const alto = canvas.offsetHeight;
                canvas.width = ancho * ratio;
                canvas.height = alto * ratio;
                ctx.scale(ratio, ratio);
                ctx.lineWidth = 2;
                ctx.lineCap = 'round';
                ctx.strokeStyle = '#111';
            }
            ajustarTamano();

            function posicion(e) {
                const r = canvas.getBoundingClientRect();
                const p = e.touches ? e.touches[0] : e;
                return { x: p.clientX - r.left, y: p.clientY - r.top };
            }

            function iniciar(e) {
                e.preventDefault();
                dibujando = true;
                const p = posicion(e);
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
            }

            function mover(e) {
                if (!dibujando) return;
                e.preventDefault();
                const p = posicion(e);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();
                hayTrazo = true;
            }

            function terminar() {
                if (!dibujando) return;
                dibujando = false;
                if (hayTrazo) {
                    input.value = canvas.toDataURL('image/png');
                    aviso.textContent = 'Firma capturada';
                    aviso.className = 'text-success small fw-semibold';
                }
            }

            canvas.addEventListener('mousedown', iniciar);
            canvas.addEventListener('mousemove', mover);
            canvas.addEventListener('mouseup', terminar);
            canvas.addEventListener('mouseleave', terminar);
            canvas.addEventListener('touchstart', iniciar);
            canvas.addEventListener('touchmove', mover);
            canvas.addEventListener('touchend', terminar);

            document.getElementById('btnLimpiar').addEventListener('click', function () {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                input.value = '';
                hayTrazo = false;
                aviso.textContent = 'Firme dentro del recuadro';
                aviso.className = 'text-muted small';
            });

            document.getElementById('formEntrega').addEventListener('submit', function (e) {
                if (!input.value) {
                    e.preventDefault();
                    aviso.textContent = 'Falta la firma del trabajador';
                    aviso.className = 'text-danger small fw-semibold';
                    canvas.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });
        })();
    </script>
}
