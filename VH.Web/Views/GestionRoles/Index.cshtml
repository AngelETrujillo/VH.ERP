@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.Rol.RolResponseDto>
@{
    ViewData["BuscarPlaceholder"] = "Buscar por nombre o descripción…";
}

@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-shield-lock"></i> Roles del Sistema</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo Rol
    </a>
</div>


<div class="card">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">
            <div class="col-lg-7">
                @await Html.PartialAsync("_BarraBusqueda", Model)
            </div>
            <div class="col-lg-5 text-lg-end">
                <span class="badge bg-secondary">@Model.Total rol(es)</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Fecha Creación</th>
                        <th width="120">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in Model.Renglones)
                    {
                        <tr>
                            <td><strong>@rol.Name</strong></td>
                            <td>@rol.Descripcion</td>
                            <td>
                                @if (rol.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@rol.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@rol.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@rol.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este rol?')">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Paginador", Model)
    </div>
</div>