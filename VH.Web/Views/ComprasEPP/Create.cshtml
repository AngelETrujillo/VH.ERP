@model VH.Services.DTOs.CompraEPPRequestDto
@{
    ViewData["Title"] = "Nueva Compra";
    var materiales = ViewBag.Materiales as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var almacenes = ViewBag.Almacenes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-cart-plus text-primary me-2"></i>Nueva Compra
            </h2>
            <p class="text-muted mb-0">Una factura del proveedor con todos sus materiales</p>
        </div>
    </div>

    <form asp-action="Create" method="post" id="formCompra">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <!-- Documento -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Documento</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="IdProveedor" class="form-label fw-semibold">Proveedor <span class="text-danger">*</span></label>
                        <select asp-for="IdProveedor" class="form-select form-select-lg" asp-items="@ViewBag.Proveedores">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="IdProveedor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FechaCompra" class="form-label fw-semibold">Fecha <span class="text-danger">*</span></label>
                        <input asp-for="FechaCompra" type="date" class="form-control form-control-lg" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="FechaCompra" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NumeroDocumento" class="form-label fw-semibold">No. Factura</label>
                        <input asp-for="NumeroDocumento" class="form-control form-control-lg" placeholder="FAC-2026-001" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="UuidCFDI" class="form-label fw-semibold">UUID del CFDI</label>
                        <input asp-for="UuidCFDI" class="form-control form-control-lg" placeholder="Folio fiscal" />
                        <small class="text-muted">Para conciliar con contabilidad</small>
                    </div>
                    <div class="col-12">
                        <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                        <input asp-for="Observaciones" class="form-control" placeholder="Notas adicionales..." />
                    </div>
                </div>
            </div>
        </div>

        <!-- Renglones -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Materiales de esta factura</h5>
                <button type="button" class="btn btn-light btn-sm fw-semibold" id="btnAgregar">
                    <i class="bi bi-plus-lg me-1"></i>Agregar material
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover align-middle mb-0" id="tablaRenglones">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3" style="min-width:200px;">Material <span class="text-danger">*</span></th>
                                <th style="min-width:170px;">Almacén destino <span class="text-danger">*</span></th>
                                <th style="width:110px;">Cantidad <span class="text-danger">*</span></th>
                                <th style="width:130px;">Precio unit. <span class="text-danger">*</span></th>
                                <th style="width:100px;">Talla</th>
                                <th style="width:150px;">Caducidad</th>
                                <th class="text-end" style="width:120px;">Importe</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTabla"></tbody>
                    </table>
                </div>
                <div class="d-md-none p-3" id="cuerpoCards"></div>

                <div class="text-center py-5 text-muted" id="vacio">
                    <i class="bi bi-inbox display-5"></i>
                    <p class="mt-2 mb-0">Agregue al menos un material a la factura</p>
                </div>

                <div class="alert alert-warning m-3 d-none" id="avisoVacio" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>Agregue al menos un material antes de guardar.
                </div>
            </div>
        </div>

        <!-- Totales -->
        <div class="row justify-content-end">
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold" id="lblSubtotal">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label asp-for="Iva" class="text-muted mb-0">IVA</label>
                            <div class="input-group input-group-sm" style="width:160px;">
                                <span class="input-group-text">$</span>
                                <input asp-for="Iva" type="number" step="0.01" min="0" class="form-control text-end" id="inputIva" value="0" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0 mb-3" id="btnIva16">Calcular IVA 16%</button>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold fs-5">Total</span>
                            <span class="fw-bold fs-5 text-success" id="lblTotal">$0.00</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-check-lg me-2"></i>Registrar Compra
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const MATERIALES = @Html.Raw(Json.Serialize(materiales.Select(m => new { v = m.Value, t = m.Text })));
        const ALMACENES  = @Html.Raw(Json.Serialize(almacenes.Select(a => new { v = a.Value, t = a.Text })));

        let contador = 0;

        function opciones(lista) {
            return '<option value="">-- Seleccionar --</option>' +
                lista.map(o => `<option value="${o.v}">${o.t}</option>`).join('');
        }

        function agregarRenglon() {
            const i = contador++;

            const tr = document.createElement('tr');
            tr.id = `fila_${i}`;
            tr.innerHTML = `
                <td class="ps-3">
                    <select name="Detalles[${i}].IdMaterial" class="form-select form-select-sm" required>
                        ${opciones(MATERIALES)}
                    </select>
                </td>
                <td>
                    <select name="Detalles[${i}].IdAlmacen" class="form-select form-select-sm" required>
                        ${opciones(ALMACENES)}
                    </select>
                </td>
                <td>
                    <input type="number" name="Detalles[${i}].Cantidad" class="form-control form-control-sm cantidad"
                           step="0.01" min="0.01" required oninput="recalcular(${i})">
                </td>
                <td>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input type="number" name="Detalles[${i}].PrecioUnitario" class="form-control precio"
                               step="0.01" min="0.01" required oninput="recalcular(${i})">
                    </div>
                </td>
                <td>
                    <input type="text" name="Detalles[${i}].Talla" class="form-control form-control-sm" maxlength="20" placeholder="-">
                </td>
                <td>
                    <input type="date" name="Detalles[${i}].FechaCaducidad" class="form-control form-control-sm">
                </td>
                <td class="text-end fw-semibold" id="importe_${i}">$0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarRenglon(${i})" title="Quitar">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>`;
            document.getElementById('cuerpoTabla').appendChild(tr);

            const card = document.createElement('div');
            card.id = `card_${i}`;
            card.className = 'border rounded p-3 mb-2';
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold small text-muted">Material #${i + 1}</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarRenglon(${i})">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <p class="small text-muted mb-0">Use la vista de escritorio para editar este renglón.</p>`;
            document.getElementById('cuerpoCards').appendChild(card);

            actualizarVista();
        }

        function eliminarRenglon(i) {
            document.getElementById(`fila_${i}`)?.remove();
            document.getElementById(`card_${i}`)?.remove();
            actualizarVista();
            recalcularTotales();
        }

        function recalcular(i) {
            const fila = document.getElementById(`fila_${i}`);
            if (!fila) return;
            const cant = parseFloat(fila.querySelector('.cantidad').value) || 0;
            const precio = parseFloat(fila.querySelector('.precio').value) || 0;
            document.getElementById(`importe_${i}`).textContent = formato(cant * precio);
            recalcularTotales();
        }

        function recalcularTotales() {
            let subtotal = 0;
            document.querySelectorAll('#cuerpoTabla tr').forEach(fila => {
                const cant = parseFloat(fila.querySelector('.cantidad')?.value) || 0;
                const precio = parseFloat(fila.querySelector('.precio')?.value) || 0;
                subtotal += cant * precio;
            });
            const iva = parseFloat(document.getElementById('inputIva').value) || 0;
            document.getElementById('lblSubtotal').textContent = formato(subtotal);
            document.getElementById('lblTotal').textContent = formato(subtotal + iva);
            return subtotal;
        }

        function formato(n) {
            return '$' + n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function actualizarVista() {
            const hay = document.querySelectorAll('#cuerpoTabla tr').length > 0;
            document.getElementById('vacio').classList.toggle('d-none', hay);
        }

        document.getElementById('btnAgregar').addEventListener('click', agregarRenglon);
        document.getElementById('inputIva').addEventListener('input', recalcularTotales);

        document.getElementById('btnIva16').addEventListener('click', function () {
            const subtotal = recalcularTotales();
            document.getElementById('inputIva').value = (subtotal * 0.16).toFixed(2);
            recalcularTotales();
        });

        document.getElementById('formCompra').addEventListener('submit', function (e) {
            if (document.querySelectorAll('#cuerpoTabla tr').length === 0) {
                e.preventDefault();
                document.getElementById('avisoVacio').classList.remove('d-none');
            }
        });

        // La factura siempre trae al menos un renglón.
        agregarRenglon();
    </script>
}
