@model VH.Services.DTOs.RequisicionEPPRequestDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Prestar herramienta";
    var empleados = ViewBag.Empleados as List<SelectListItem> ?? new();
    var materiales = ViewBag.Materiales as List<SelectListItem> ?? new();
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Create" class="btn btn-outline-secondary me-3" title="Cambiar de tipo">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-tools text-info me-2"></i>Herramienta en préstamo
            </h2>
            <p class="text-muted mb-0">Se presta a una persona y se espera de vuelta</p>
        </div>
    </div>

    @if (!materiales.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No hay materiales de tipo <strong>Herramienta</strong> activos en el catálogo.
            Reviselos en Materiales, y marque como <strong>retornables</strong> los que
            deban volver al almacén.
        </div>
    }

    <form asp-action="Create" method="post" id="formRequisicion">
        <input type="hidden" name="tipo" value="@((int)VH.Services.Entities.TipoMaterial.Herramienta)" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_RequisicionCabecera" model="Model" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Qué se presta, y a quién</h5>
                <button type="button" class="btn btn-light btn-sm fw-semibold" id="btnAgregar">
                    <i class="bi bi-plus-lg me-1"></i>Agregar herramienta
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3" style="min-width:250px;">A quién se presta <span class="text-danger">*</span></th>
                                <th style="min-width:250px;">Herramienta <span class="text-danger">*</span></th>
                                <th style="width:140px;">Cantidad <span class="text-danger">*</span></th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTabla"></tbody>
                    </table>
                </div>

                <div class="text-center py-5 text-muted" id="vacio">
                    <i class="bi bi-inbox display-5"></i>
                    <p class="mt-2 mb-0">Agregue al menos una herramienta</p>
                </div>

                <div class="alert alert-warning m-3 d-none" id="avisoVacio" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>Agregue al menos una herramienta antes de guardar.
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Un préstamo, no una entrega.</strong> La persona firma al
                    recibirla, igual que con el EPP, pero la herramienta sigue siendo de la
                    empresa: aparecerá en <em>Devoluciones</em> hasta que vuelva, y ahí se
                    registra en qué estado regresó.
                </div>
                <div class="alert alert-secondary">
                    <i class="bi bi-clock-history me-2"></i>
                    El plazo de devolución todavía no se configura por material: por ahora
                    el préstamo no vence, y Devoluciones sólo muestra cuántos días lleva fuera.
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 bg-light mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Renglones</span>
                            <span class="fw-semibold" id="lblRenglones">0</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Trabajadores</span>
                            <span class="fw-semibold" id="lblEmpleados">0</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-info btn-lg px-5 text-white">
                        <i class="bi bi-check-lg me-2"></i>Enviar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const EMPLEADOS = @Html.Raw(Json.Serialize(empleados.Select(e => new { v = e.Value, t = e.Text })));
        const MATERIALES = @Html.Raw(Json.Serialize(materiales.Select(m => new { v = m.Value, t = m.Text })));

        let contador = 0;

        function opciones(lista, marcado) {
            return '<option value="">-- Seleccionar --</option>' +
                lista.map(o => `<option value="${o.v}"${o.v === marcado ? ' selected' : ''}>${o.t}</option>`).join('');
        }

        function agregarRenglon(empleadoPrevio) {
            const i = contador++;
            const fila = document.createElement('tr');
            fila.id = `fila${i}`;
            // Sin campo de talla: una herramienta no se presta por talla.
            fila.innerHTML = `
                <td class="ps-3">
                    <select name="Detalles[${i}].IdEmpleadoDestino" required
                            class="form-select form-select-sm">${opciones(EMPLEADOS, empleadoPrevio)}</select>
                </td>
                <td>
                    <select name="Detalles[${i}].IdMaterial" required
                            class="form-select form-select-sm">${opciones(MATERIALES, '')}</select>
                </td>
                <td>
                    <input type="number" name="Detalles[${i}].CantidadSolicitada" value="1"
                           step="1" min="1" required class="form-control form-control-sm">
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="eliminarRenglon(${i})" title="Quitar">
                        <i class="bi bi-x"></i>
                    </button>
                </td>`;

            document.getElementById('cuerpoTabla').appendChild(fila);
            actualizarResumen();
        }

        function eliminarRenglon(i) {
            document.getElementById(`fila${i}`)?.remove();
            actualizarResumen();
        }

        function actualizarResumen() {
            const filas = document.querySelectorAll('#cuerpoTabla tr');
            document.getElementById('lblRenglones').textContent = filas.length;

            const personas = new Set();
            document.querySelectorAll('[name$=".IdEmpleadoDestino"]').forEach(s => {
                if (s.value) personas.add(s.value);
            });
            document.getElementById('lblEmpleados').textContent = personas.size;
            document.getElementById('vacio').classList.toggle('d-none', filas.length > 0);
        }

        document.getElementById('cuerpoTabla').addEventListener('change', actualizarResumen);

        document.getElementById('btnAgregar').addEventListener('click', function () {
            const selects = document.querySelectorAll('[name$=".IdEmpleadoDestino"]');
            const ultimo = selects.length ? selects[selects.length - 1].value : '';
            agregarRenglon(ultimo);
        });

        document.getElementById('formRequisicion').addEventListener('submit', function (e) {
            if (!document.querySelectorAll('#cuerpoTabla tr').length) {
                e.preventDefault();
                document.getElementById('avisoVacio').classList.remove('d-none');
            }
        });

        agregarRenglon('');
    </script>
}
