@model VH.Services.DTOs.RequisicionEPPRequestDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Nueva Requisición";
    var empleados = ViewBag.Empleados as List<SelectListItem> ?? new();
    var materiales = ViewBag.Materiales as List<SelectListItem> ?? new();
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-file-earmark-plus text-primary me-2"></i>Nueva Requisición
            </h2>
            <p class="text-muted mb-0">Un documento puede pedir material para varios trabajadores</p>
        </div>
    </div>

    <form asp-action="Create" method="post" id="formRequisicion">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <!-- Datos del documento -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Datos de la Requisición</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="IdAlmacen" class="form-label fw-semibold">
                            Almacén <span class="text-danger">*</span>
                        </label>
                        <select asp-for="IdAlmacen" asp-items="@(ViewBag.Almacenes as List<SelectListItem>)"
                                class="form-select form-select-lg">
                            <option value="">-- Seleccione almacén --</option>
                        </select>
                        <span asp-validation-for="IdAlmacen" class="text-danger small"></span>
                        <small class="text-muted">De donde se surtirá el material</small>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FechaRequerida" class="form-label fw-semibold">Fecha requerida</label>
                        <input asp-for="FechaRequerida" type="date" class="form-control form-control-lg" />
                        <small class="text-muted">Para priorizar faltantes</small>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Justificacion" class="form-label fw-semibold">Justificación</label>
                        <input asp-for="Justificacion" class="form-control form-control-lg"
                               placeholder="Motivo de la requisición..." />
                        <span asp-validation-for="Justificacion" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Renglones -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Materiales solicitados</h5>
                <button type="button" class="btn btn-light btn-sm fw-semibold" id="btnAgregar">
                    <i class="bi bi-plus-lg me-1"></i>Agregar material
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3" style="min-width:220px;">Para quién <span class="text-danger">*</span></th>
                                <th style="min-width:220px;">Material <span class="text-danger">*</span></th>
                                <th style="width:120px;">Cantidad <span class="text-danger">*</span></th>
                                <th style="width:120px;">Talla</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTabla"></tbody>
                    </table>
                </div>

                <div class="text-center py-5 text-muted" id="vacio">
                    <i class="bi bi-inbox display-5"></i>
                    <p class="mt-2 mb-0">Agregue al menos un material</p>
                </div>

                <div class="alert alert-warning m-3 d-none" id="avisoVacio" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>Agregue al menos un material antes de guardar.
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Cada trabajador firma únicamente el material que recibe. Si en este
                    documento pide para dos personas, el almacén surtirá y recogerá dos
                    firmas por separado.
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 bg-light mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Renglones</span>
                            <span class="fw-semibold" id="lblRenglones">0</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Trabajadores</span>
                            <span class="fw-semibold" id="lblEmpleados">0</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-check-lg me-2"></i>Enviar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const EMPLEADOS = @Html.Raw(Json.Serialize(empleados.Select(e => new { v = e.Value, t = e.Text })));
        const MATERIALES = @Html.Raw(Json.Serialize(materiales.Select(m => new { v = m.Value, t = m.Text })));

        let contador = 0;

        function opcionesEmpleado() {
            // Todo renglón va a una persona, que es quien firma al recibirlo. El
            // consumo cargado a la obra necesita una salida sin destinatario, que
            // llega con el módulo de movimientos de almacén.
            return '<option value="">-- Seleccionar --</option>' +
                EMPLEADOS.map(e => `<option value="${e.v}">${e.t}</option>`).join('');
        }

        function opcionesMaterial() {
            return '<option value="">-- Seleccionar --</option>' +
                MATERIALES.map(m => `<option value="${m.v}">${m.t}</option>`).join('');
        }

        function agregarRenglon(empleadoPrevio) {
            const i = contador++;
            const tr = document.createElement('tr');
            tr.id = `fila_${i}`;
            tr.innerHTML = `
                <td class="ps-3">
                    <select name="Detalles[${i}].IdEmpleadoDestino" required
                            class="form-select form-select-sm empleado-select"
                            onchange="actualizarResumen()">
                        ${opcionesEmpleado()}
                    </select>
                </td>
                <td>
                    <select name="Detalles[${i}].IdMaterial" class="form-select form-select-sm" required>
                        ${opcionesMaterial()}
                    </select>
                </td>
                <td>
                    <input type="number" name="Detalles[${i}].CantidadSolicitada"
                           class="form-control form-control-sm" min="0.01" step="0.01" value="1" required>
                </td>
                <td>
                    <input type="text" name="Detalles[${i}].TallaSolicitada"
                           class="form-control form-control-sm" maxlength="20" placeholder="M, 28...">
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarRenglon(${i})" title="Quitar">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>`;
            document.getElementById('cuerpoTabla').appendChild(tr);

            // Pedir varias cosas para la misma persona es lo común, así que el
            // renglón nuevo hereda el destino del anterior.
            if (empleadoPrevio) {
                tr.querySelector('.empleado-select').value = empleadoPrevio;
            }

            actualizarResumen();
        }

        function eliminarRenglon(i) {
            document.getElementById(`fila_${i}`)?.remove();
            actualizarResumen();
        }

        function actualizarResumen() {
            const filas = document.querySelectorAll('#cuerpoTabla tr');
            document.getElementById('vacio').classList.toggle('d-none', filas.length > 0);
            document.getElementById('lblRenglones').textContent = filas.length;

            const empleados = new Set();
            document.querySelectorAll('.empleado-select').forEach(s => {
                if (s.value) empleados.add(s.value);
            });
            document.getElementById('lblEmpleados').textContent = empleados.size;
        }

        document.getElementById('btnAgregar').addEventListener('click', function () {
            const selects = document.querySelectorAll('.empleado-select');
            const ultimo = selects.length ? selects[selects.length - 1].value : '';
            agregarRenglon(ultimo);
        });

        document.getElementById('formRequisicion').addEventListener('submit', function (e) {
            if (document.querySelectorAll('#cuerpoTabla tr').length === 0) {
                e.preventDefault();
                document.getElementById('avisoVacio').classList.remove('d-none');
            }
        });

        agregarRenglon('');
    </script>
}
