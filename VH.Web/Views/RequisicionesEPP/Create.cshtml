@{
    ViewData["Title"] = "Nueva Requisición";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-file-earmark-plus text-primary me-2"></i>¿Qué vas a pedir?
            </h2>
            <p class="text-muted mb-0">
                Las tres van al mismo almacén y pasan por la misma autorización.
                Cambia lo que hay que capturar.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <a asp-action="CrearEPP" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 card-tipo">
                    <div class="card-body p-4">
                        <div class="icono-tipo bg-success-subtle text-success mb-3">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Equipo de protección</h4>
                        <p class="text-muted mb-3">
                            Cascos, botas, guantes. Se entrega a una persona concreta
                            y la persona firma al recibirlo.
                        </p>
                        <ul class="list-unstyled small text-muted mb-0">
                            <li><i class="bi bi-check2 text-success me-2"></i>Se pide para un trabajador</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>Talla cuando el material la usa</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>Sale con firma</li>
                        </ul>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-action="CrearConsumible" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 card-tipo">
                    <div class="card-body p-4">
                        <div class="icono-tipo bg-warning-subtle text-warning mb-3">
                            <i class="bi bi-bricks"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Consumible de obra</h4>
                        <p class="text-muted mb-3">
                            Silicón, filtros, material que se gasta en la construcción.
                            Se carga a una obra o a una partida del presupuesto.
                        </p>
                        <ul class="list-unstyled small text-muted mb-0">
                            <li><i class="bi bi-check2 text-warning me-2"></i>Se carga a una obra</li>
                            <li><i class="bi bi-check2 text-warning me-2"></i>O a una partida, para costearlo</li>
                            <li><i class="bi bi-check2 text-warning me-2"></i>Sale sin firma: no lo recibe nadie</li>
                        </ul>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-action="CrearHerramienta" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0 card-tipo">
                    <div class="card-body p-4">
                        <div class="icono-tipo bg-info-subtle text-info mb-3">
                            <i class="bi bi-tools"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Herramienta en préstamo</h4>
                        <p class="text-muted mb-3">
                            Rotomartillos, equipo retornable. Se presta a una persona
                            y sigue siendo de la empresa aunque esté en la obra.
                        </p>
                        <ul class="list-unstyled small text-muted mb-0">
                            <li><i class="bi bi-check2 text-info me-2"></i>Se presta a un trabajador</li>
                            <li><i class="bi bi-check2 text-info me-2"></i>Firma al recibirla</li>
                            <li><i class="bi bi-check2 text-info me-2"></i>Se espera de vuelta</li>
                        </ul>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="alert alert-secondary mt-4 d-flex align-items-start">
        <i class="bi bi-info-circle me-2 fs-5"></i>
        <div>
            Un documento pide un solo tipo. Si hace falta pedir EPP y consumible para
            la misma obra, son dos requisiciones: las autoriza la misma persona, pero
            cada una se surte distinto.
        </div>
    </div>
</div>

<style>
    .card-tipo {
        transition: transform .12s ease, box-shadow .12s ease;
        border: 1px solid transparent !important;
    }

    .card-tipo:hover {
        transform: translateY(-3px);
        box-shadow: 0 .6rem 1.4rem rgba(0, 0, 0, .1) !important;
        border-color: var(--bs-primary) !important;
    }

    .icono-tipo {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    @@media (prefers-reduced-motion: reduce) {
        .card-tipo { transition: none; }
        .card-tipo:hover { transform: none; }
    }
</style>
