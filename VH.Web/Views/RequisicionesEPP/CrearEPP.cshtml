@model VH.Services.DTOs.RequisicionEPPRequestDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Pedir equipo de protección";
    var empleados = ViewBag.Empleados as List<SelectListItem> ?? new();
    var materiales = ViewBag.Materiales as List<SelectListItem> ?? new();
    var conTalla = ViewBag.MaterialesConTalla as List<int> ?? new();
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Create" class="btn btn-outline-secondary me-3" title="Cambiar de tipo">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-shield-check text-success me-2"></i>Equipo de protección
            </h2>
            <p class="text-muted mb-0">Se entrega a una persona, y la persona firma al recibirlo</p>
        </div>
    </div>

    @if (!materiales.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No hay materiales de tipo <strong>EPP</strong> activos en el catálogo.
            Revise que estén dados de alta con ese tipo.
        </div>
    }

    <form asp-action="Create" method="post" id="formRequisicion">
        <input type="hidden" name="tipo" value="@((int)VH.Services.Entities.TipoMaterial.EPP)" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_RequisicionCabecera" model="Model" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Qué se pide, y para quién</h5>
                <button type="button" class="btn btn-light btn-sm fw-semibold" id="btnAgregar">
                    <i class="bi bi-plus-lg me-1"></i>Agregar material
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3" style="min-width:230px;">Para quién <span class="text-danger">*</span></th>
                                <th style="min-width:230px;">Material <span class="text-danger">*</span></th>
                                <th style="width:120px;">Cantidad <span class="text-danger">*</span></th>
                                <th style="width:130px;">Talla</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTabla"></tbody>
                    </table>
                </div>

                <div class="text-center py-5 text-muted" id="vacio">
                    <i class="bi bi-inbox display-5"></i>
                    <p class="mt-2 mb-0">Agregue al menos un material</p>
                </div>

                <div class="alert alert-warning m-3 d-none" id="avisoVacio" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>Agregue al menos un material antes de guardar.
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Cada trabajador firma únicamente el material que recibe. Si en este
                    documento pide para dos personas, el almacén surtirá y recogerá dos
                    firmas por separado.
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 bg-light mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Renglones</span>
                            <span class="fw-semibold" id="lblRenglones">0</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Trabajadores</span>
                            <span class="fw-semibold" id="lblEmpleados">0</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="bi bi-check-lg me-2"></i>Enviar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const EMPLEADOS = @Html.Raw(Json.Serialize(empleados.Select(e => new { v = e.Value, t = e.Text })));
        const MATERIALES = @Html.Raw(Json.Serialize(materiales.Select(m => new { v = m.Value, t = m.Text })));

        // Los que se entregan por talla. El campo se habilita sólo en ésos, en vez
        // de mostrarlo siempre: una talla capturada sobre un material que no la usa
        // llegaba al reparto y dejaba el renglón imposible de surtir.
        // La serialización se cierra en su propia constante: pegarle el .map hace
        // que Razor lo tome como código suyo y la vista no compila.
        const IDS_CON_TALLA = @Html.Raw(Json.Serialize(conTalla));
        const CON_TALLA = new Set(IDS_CON_TALLA.map(String));

        let contador = 0;

        function opciones(lista, marcado) {
            return '<option value="">-- Seleccionar --</option>' +
                lista.map(o => `<option value="${o.v}"${o.v === marcado ? ' selected' : ''}>${o.t}</option>`).join('');
        }

        function agregarRenglon(empleadoPrevio) {
            const i = contador++;
            const fila = document.createElement('tr');
            fila.id = `fila${i}`;
            fila.innerHTML = `
                <td class="ps-3">
                    <select name="Detalles[${i}].IdEmpleadoDestino" required
                            class="form-select form-select-sm">${opciones(EMPLEADOS, empleadoPrevio)}</select>
                </td>
                <td>
                    <select name="Detalles[${i}].IdMaterial" required data-idx="${i}"
                            class="form-select form-select-sm js-material">${opciones(MATERIALES, '')}</select>
                </td>
                <td>
                    <input type="number" name="Detalles[${i}].CantidadSolicitada" value="1"
                           step="0.01" min="0.01" required class="form-control form-control-sm">
                </td>
                <td>
                    <input type="text" name="Detalles[${i}].TallaSolicitada" id="talla${i}"
                           class="form-control form-control-sm" placeholder="—" disabled
                           title="Se habilita cuando el material se entrega por talla">
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="eliminarRenglon(${i})" title="Quitar">
                        <i class="bi bi-x"></i>
                    </button>
                </td>`;

            document.getElementById('cuerpoTabla').appendChild(fila);
            actualizarResumen();
        }

        function eliminarRenglon(i) {
            document.getElementById(`fila${i}`)?.remove();
            actualizarResumen();
        }

        function actualizarResumen() {
            const filas = document.querySelectorAll('#cuerpoTabla tr');
            document.getElementById('lblRenglones').textContent = filas.length;

            const personas = new Set();
            document.querySelectorAll('[name$=".IdEmpleadoDestino"]').forEach(s => {
                if (s.value) personas.add(s.value);
            });
            document.getElementById('lblEmpleados').textContent = personas.size;
            document.getElementById('vacio').classList.toggle('d-none', filas.length > 0);
        }

        document.getElementById('cuerpoTabla').addEventListener('change', function (e) {
            const sel = e.target.closest('.js-material');
            if (sel) {
                const talla = document.getElementById(`talla${sel.dataset.idx}`);
                const usa = CON_TALLA.has(sel.value);
                talla.disabled = !usa;
                talla.placeholder = usa ? 'M, 28…' : '—';
                if (!usa) talla.value = '';
            }
            actualizarResumen();
        });

        document.getElementById('btnAgregar').addEventListener('click', function () {
            const selects = document.querySelectorAll('[name$=".IdEmpleadoDestino"]');
            const ultimo = selects.length ? selects[selects.length - 1].value : '';
            agregarRenglon(ultimo);
        });

        document.getElementById('formRequisicion').addEventListener('submit', function (e) {
            if (!document.querySelectorAll('#cuerpoTabla tr').length) {
                e.preventDefault();
                document.getElementById('avisoVacio').classList.remove('d-none');
            }
        });

        agregarRenglon('');
    </script>
}
