@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.EmpleadoResponseDto>
@{
    bool? filtroActivo = ViewBag.FiltroActivo;
    ViewData["BuscarPlaceholder"] = "Buscar por nombre, nómina, puesto u obra…";
    var filtrosEstado = new Dictionary<string, string?>
    {
        ["activo"] = filtroActivo?.ToString().ToLowerInvariant()
    };
    ViewData["FiltrosPaginador"] = filtrosEstado;
    ViewData["FiltrosOcultos"] = filtrosEstado;

    // El estado deja de ser un radio que esconde filas y pasa a ser una liga:
    // filtrando en el navegador, "Inactivos" sólo habría ocultado los activos de
    // la página que estuvieras viendo.
    string LigaEstado(bool? activo)
    {
        var partes = new List<string> { $"tamano={Model.Tamano}" };
        if (activo.HasValue) partes.Add($"activo={activo.Value.ToString().ToLowerInvariant()}");
        if (Model.Buscado != null) partes.Add($"buscar={Uri.EscapeDataString(Model.Buscado)}");
        return "?" + string.Join("&", partes);
    }
}

@{
    ViewData["Title"] = "Empleados";
    var esSuperAdmin = User.IsInRole("SuperAdmin");
    var puedeCrear = PermisoHelper.PuedeCrear(Context.Session, "EMPLEADOS", esSuperAdmin);
    var puedeEditar = PermisoHelper.PuedeEditar(Context.Session, "EMPLEADOS", esSuperAdmin);
    var puedeEliminar = PermisoHelper.PuedeEliminar(Context.Session, "EMPLEADOS", esSuperAdmin);
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="mb-1 fw-bold text-dark fs-4 fs-md-2">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Gestión de Empleados
            </h2>
            <p class="text-muted mb-0 small">Administra el personal de la empresa</p>
        </div>

        @if (puedeCrear)
        {
            @if (Html.PuedeCrear("EMPLEADOS"))
            {
                <a asp-action="Create"
                class="btn btn-primary w-100 w-md-auto">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Empleado
                </a>
            }
        }

    </div>


    <!-- Alertas -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Card principal -->
    <div class="card shadow-sm border-0">
        
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-lg-7">
                    @await Html.PartialAsync("_BarraBusqueda", Model)
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="btn-group me-2" role="group" aria-label="Filtrar por estado">
                        <a href="@LigaEstado(null)" class="btn btn-sm @(filtroActivo == null ? "btn-secondary" : "btn-outline-secondary")">Todos</a>
                        <a href="@LigaEstado(true)" class="btn btn-sm @(filtroActivo == true ? "btn-success" : "btn-outline-success")">Activos</a>
                        <a href="@LigaEstado(false)" class="btn btn-sm @(filtroActivo == false ? "btn-danger" : "btn-outline-danger")">Inactivos</a>
                    </div>
                    <span class="badge bg-secondary">@Model.Total empleado(s)</span>
                </div>
            </div>

        
        </div>

        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Empleado</th>
                            <th class="d-none d-md-table-cell">No. Nómina</th>
                            <th class="d-none d-lg-table-cell">Puesto</th>
                            <th class="d-none d-lg-table-cell">Proyecto</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width:140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Vacio)
                        {
                            @foreach (var item in Model.Renglones)
                            {
                                var iniciales = $"{item.Nombre?.FirstOrDefault()}{item.ApellidoPaterno?.FirstOrDefault()}".ToUpper();
                                <tr data-estado="@(item.Activo ? "activo" : "inactivo")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-3 @(item.Activo ? "bg-primary" : "bg-secondary")">
                                                @iniciales
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@item.Nombre @item.ApellidoPaterno</h6>
                                                <small class="text-muted">@item.ApellidoMaterno</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <code class="bg-light px-2 py-1 rounded">@item.NumeroNomina</code>
                                    </td>
                                    <td class="d-none d-lg-table-cell">@item.Puesto</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.NombreProyecto))
                                        {
                                            <span class="badge bg-info-subtle text-info">
                                                <i class="bi bi-building me-1"></i>@item.NombreProyecto
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin asignar</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">

                                        <!-- Desktop -->
                                        <div class="btn-group btn-group-sm d-none d-md-inline-flex">
                                            <a asp-action="Details" asp-route-id="@item.IdEmpleado"
                                               class="btn btn-outline-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (puedeEditar)
                                            {
                                                @if (Html.PuedeEditar("EMPLEADOS"))
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.IdEmpleado"
                                                    class="btn btn-outline-warning" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                    </a>
                                                }
                                            }

                                            @if (puedeEliminar)
                                            {
                                                @if (Html.PuedeEliminar("EMPLEADOS"))
                                                {
                                                    <a asp-action="Delete" asp-route-id="@item.IdEmpleado"
                                                    class="btn btn-outline-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                    </a>
                                                }
                                            }
                                        </div>

                                        <!-- Mobile -->
                                        <div class="d-flex d-md-none gap-2 justify-content-center">

                                            <a asp-action="Details" asp-route-id="@item.IdEmpleado"
                                               class="btn btn-outline-info btn-sm">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (puedeEditar)
                                            {
                                                @if (Html.PuedeEditar("EMPLEADOS"))
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.IdEmpleado"
                                                    class="btn btn-outline-warning btn-sm">
                                                    <i class="bi bi-pencil"></i>
                                                    </a>
                                                }
                                            }

                                            @if (puedeEliminar)
                                            {
                                                @if (Html.PuedeEliminar("EMPLEADOS"))
                                                {
                                                    <a asp-action="Delete" asp-route-id="@item.IdEmpleado"
                                                    class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                    </a>
                                                }
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="text-center py-5">
                                        <i class="bi bi-people display-4 text-muted"></i>
                                        <h5 class="mt-3 text-muted">No hay empleados registrados</h5>
                                        <p class="text-muted">Comienza agregando tu primer empleado</p>
                                        @if (Html.PuedeCrear("EMPLEADOS"))
                                        {
                                            <a asp-action="Create" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-2"></i>Agregar Empleado
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Paginador", Model)
        </div>
    </div>
</div>

<style>
    @* .avatar-circle {
        width: 36px;
        height: 36px;
        font-size: 0.8rem;
    }

    @media (min-width:768px) {
        .avatar-circle {
            width: 42px;
            height: 42px;
            font-size: 0.9rem;
        }
    } *@

    .avatar-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .table > tbody > tr:hover {
        background-color: #f8f9fa;
    }

    .btn-group-sm > .btn {
        padding: 0.4rem 0.6rem;
    }
</style>

@section Scripts {
    <script>
        // Buscar y filtrar los hace el servidor. Queda sólo devolver el foco al
        // campo, para corregir el texto sin volver a tomar el ratón.
        (function () {
            const campo = document.getElementById('campoBuscar');
            if (campo && campo.value) {
                campo.focus();
                campo.setSelectionRange(campo.value.length, campo.value.length);
            }
        })();
        });
        document.querySelectorAll('input[name="filtroEstado"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const filtro = this.id.replace('filtro', '').toLowerCase();
                document.querySelectorAll('#dataTable tbody tr').forEach(row => {
                    const estado = row.dataset.estado;
                    if (filtro === 'todos') row.style.display = '';
                    else if (filtro === 'activos') row.style.display = estado === 'activo' ? '' : 'none';
                    else if (filtro === 'inactivos') row.style.display = estado === 'inactivo' ? '' : 'none';
                });
            });
        });
    </script>
}