@model IEnumerable<VH.Services.DTOs.DevolucionResponseDto>
@{
    ViewData["Title"] = "Devoluciones anteriores";
    var lista = Model?.ToList() ?? new List<VH.Services.DTOs.DevolucionResponseDto>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-clock-history text-primary me-2"></i>Devoluciones anteriores
            </h2>
            <p class="text-muted mb-0">Todo lo que ha vuelto al almacén, y lo que se dio por perdido</p>
        </div>
        <a asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-arrow-return-left me-2"></i>Qué sigue prestado
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">Historial</h6>
            <span class="badge bg-secondary">@lista.Count devolución(es)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Material</th>
                            <th>Quién lo tenía</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Estado</th>
                            <th>Recibió</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lista.Any())
                        {
                            @foreach (var d in lista)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div>@d.FechaDevolucion.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@d.FechaDevolucion.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@d.NombreMaterial</span>
                                        <br /><small class="text-muted">Entrega #@d.IdEntrega</small>
                                    </td>
                                    <td>@d.NombreEmpleado</td>
                                    <td class="text-center fw-semibold">@d.Cantidad.FormatoCantidad() @d.UnidadMedida</td>
                                    <td class="text-center">
                                        <span class="badge bg-@d.EstadoClase">@d.EstadoTexto</span>
                                    </td>
                                    <td><small>@d.NombreUsuarioRecibe</small></td>
                                    <td><small class="text-muted">@d.Observaciones</small></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Todavía no se ha registrado ninguna devolución.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
