@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.Usuario.UsuarioResponseDto>
@{
    ViewData["BuscarPlaceholder"] = "Buscar por nombre, usuario o correo…";
    bool? filtroActivo = ViewBag.FiltroActivo;
    var filtrosEstado = new Dictionary<string, string?>
    {
        ["activo"] = filtroActivo?.ToString().ToLowerInvariant()
    };
    ViewData["FiltrosPaginador"] = filtrosEstado;
    ViewData["FiltrosOcultos"] = filtrosEstado;

    string LigaEstado(bool? activo)
    {
        var partes = new List<string> { $"tamano={Model.Tamano}" };
        if (activo.HasValue) partes.Add($"activo={activo.Value.ToString().ToLowerInvariant()}");
        if (Model.Buscado != null) partes.Add($"buscar={Uri.EscapeDataString(Model.Buscado)}");
        return "?" + string.Join("&", partes);
    }
}

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-people"></i> Usuarios del Sistema</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo Usuario
    </a>
</div>


<div class="card">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">
            <div class="col-lg-7">
                @await Html.PartialAsync("_BarraBusqueda", Model)
            </div>
            <div class="col-lg-5 text-lg-end">
                    <div class="btn-group me-2" role="group" aria-label="Filtrar por estado">
                        <a href="@LigaEstado(null)" class="btn btn-sm @(filtroActivo == null ? "btn-secondary" : "btn-outline-secondary")">Todos</a>
                        <a href="@LigaEstado(true)" class="btn btn-sm @(filtroActivo == true ? "btn-success" : "btn-outline-success")">Activos</a>
                        <a href="@LigaEstado(false)" class="btn btn-sm @(filtroActivo == false ? "btn-danger" : "btn-outline-danger")">Inactivos</a>
                    </div>
                <span class="badge bg-secondary">@Model.Total usuario(s)</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        <th>Último Acceso</th>
                        <th width="150">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Renglones)
                    {
                        <tr>
                            <td><strong>@usuario.UserName</strong></td>
                            <td>@usuario.NombreCompleto</td>
                            <td>@usuario.Email</td>
                            <td>
                                @foreach (var rol in usuario.Roles)
                                {
                                    <span class="badge bg-info">@rol</span>
                                }
                            </td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@(usuario.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleActivo" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-warning" title="@(usuario.Activo ? "Desactivar" : "Activar")">
                                            <i class="bi bi-@(usuario.Activo ? "pause" : "play")"></i>
                                        </button>
                                    </form>
                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@usuario.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este usuario?')">
                                            <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Paginador", Model)
    </div>
</div>