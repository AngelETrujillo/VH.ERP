@model IEnumerable<VH.Services.DTOs.DescuadreDto>
@{
    ViewData["Title"] = "Descuadres de Inventario";
    var lista = Model?.ToList() ?? new List<VH.Services.DTOs.DescuadreDto>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-clipboard-data text-primary me-2"></i>Descuadres de Inventario
            </h2>
            <p class="text-muted mb-0">Existencia que el kardex no alcanza a explicar</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-journals me-2"></i>Ver kardex
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!lista.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
                <h5 class="mt-3">Todo cuadra</h5>
                <p class="text-muted mb-0">
                    Cada unidad en existencia tiene un movimiento que la explica: una compra,
                    una entrega, un traspaso o un ajuste firmado.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>@lista.Count</strong> registro(s) con existencia que no coincide con la suma de sus
            movimientos. Corrija cada uno con un ajuste por conteo desde su kardex.
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Material</th>
                                <th>Almacén</th>
                                <th class="text-end">Saldo registrado</th>
                                <th class="text-end">Suma del kardex</th>
                                <th class="text-end">Diferencia</th>
                                <th class="text-center" style="width:120px;">Kardex</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in lista)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@d.NombreMaterial</td>
                                    <td>@d.NombreAlmacen</td>
                                    <td class="text-end">@d.SaldoRegistrado.ToString("0.##")</td>
                                    <td class="text-end">@d.SaldoKardex.ToString("0.##")</td>
                                    <td class="text-end fw-bold @(d.Diferencia > 0 ? "text-success" : "text-danger")">
                                        @d.Diferencia.ToString("+0.##;-0.##")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Index"
                                           asp-route-idMaterial="@d.IdMaterial"
                                           asp-route-idAlmacen="@d.IdAlmacen"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-journals"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
