@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.Rol.RolResponseDto>
@{
    ViewData["BuscarPlaceholder"] = "Buscar por nombre o descripción…";
}

@{
    ViewData["Title"] = "Gestión de Permisos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-key"></i> Gestión de Permisos por Rol</h4>
</div>



<div class="card">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">
            <div class="col-lg-7">
                @await Html.PartialAsync("_BarraBusqueda", Model)
            </div>
            <div class="col-lg-5 text-lg-end">
                <span class="badge bg-secondary">@Model.Total rol(es)</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted mb-4">Seleccione un rol para configurar sus permisos de acceso a los módulos del sistema.</p>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Rol</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th width="150">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in Model.Renglones)
                    {
                        <tr>
                            <td><strong>@rol.Name</strong></td>
                            <td>@rol.Descripcion</td>
                            <td>
                                @if (rol.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Asignar" asp-route-id="@rol.Id" class="btn btn-primary btn-sm">
                                    <i class="bi bi-gear"></i> Configurar Permisos
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Paginador", Model)
    </div>
</div>