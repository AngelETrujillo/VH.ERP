@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.RecepcionCompraResponseDto>
@{
    ViewData["Title"] = "Recepciones";
    // Ya viene ordenado del servidor, que es quien puede ordenar el total.
    var lista = Model.Renglones;
    ViewData["BuscarPlaceholder"] = "Buscar por folio, factura, orden, proveedor, almacén, lote o material…";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-clock-history text-primary me-2"></i>Recepciones
            </h2>
            <p class="text-muted mb-0">Todo lo que ha entrado al almacén contra una orden de compra</p>
        </div>
        <a asp-action="Rastreo" class="btn btn-outline-secondary shadow-sm me-2">
            <i class="bi bi-upc-scan me-2"></i>Rastrear lote
        </a>
        <a asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-truck me-2"></i>Ver lo que viene en camino
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-lg-9">
                    @await Html.PartialAsync("_BarraBusqueda", Model)
                </div>
                <div class="col-lg-3 text-lg-end">
                    <span class="badge bg-secondary">@Model.Total recepción(es)</span>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Folio</th>
                            <th>Orden</th>
                            <th>Proveedor</th>
                            <th>Almacén</th>
                            <th>Materiales</th>
                            <th class="text-center">Aceptado</th>
                            <th class="text-end">Importe</th>
                            <th class="text-center" style="width:100px;">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lista.Any())
                        {
                            @foreach (var r in lista)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@r.Folio</div>
                                        <small class="text-muted">@r.FechaRecepcion.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>@r.FolioOrdenCompra</td>
                                    <td>@r.NombreProveedor</td>
                                    <td>
                                        <div>@r.NombreAlmacen</div>
                                        <small class="text-muted">@r.NombreProyecto</small>
                                    </td>
                                    <td><small>@r.ResumenMateriales</small></td>
                                    <td class="text-center">
                                        <span class="fw-semibold">@r.TotalAceptado.FormatoCantidad()</span>
                                        @if (r.HuboRechazo)
                                        {
                                            <div>
                                                <span class="badge bg-danger-subtle text-danger">
                                                    @r.TotalRechazado.FormatoCantidad() rechazado
                                                </span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @r.Importe.ToString("C2")
                                        @if (r.HuboDiferenciaPrecio)
                                        {
                                            <div>
                                                <span class="badge bg-warning-subtle text-warning">Precio distinto</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@r.IdRecepcion"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    @if (Model.Buscado != null)
                                    {
                                        <span>Ninguna recepción coincide con «@Model.Buscado».</span>
                                    }
                                    else
                                    {
                                        <span>Todavía no se ha recibido material contra ninguna orden.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Paginador", Model)
        </div>
    </div>
</div>
