@model VH.Services.DTOs.RecepcionCompraResponseDto
@{
    ViewData["Title"] = $"Recepción {Model.Folio}";

    var avisos = new List<string>();
    if (TempData["Avisos"] is string json)
    {
        try { avisos = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch { avisos = new(); }
    }
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-box-seam text-primary me-2"></i>Recepción @Model.Folio
            </h2>
            <p class="text-muted mb-0">
                Orden @Model.FolioOrdenCompra &middot; @Model.NombreProveedor &middot;
                recibida en @Model.NombreAlmacen el @Model.FechaRecepcion.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Html.PuedeEliminar("RECEPCIONES"))
            {
                <button type="button" class="btn btn-outline-danger shadow-sm"
                        data-bs-toggle="modal" data-bs-target="#modalDeshacer">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>Deshacer
                </button>
            }
            <a asp-action="Historial" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-clock-history me-2"></i>Historial
            </a>
            <a asp-action="Index" class="btn btn-primary shadow-sm">
                <i class="bi bi-truck me-2"></i>Bandeja
            </a>
        </div>
    </div>


    @if (avisos.Any())
    {
        <div class="alert alert-info">
            <h6 class="fw-bold"><i class="bi bi-info-circle me-2"></i>Lo que hay que saber de esta entrega</h6>
            <ul class="mb-0 ps-3">
                @foreach (var aviso in avisos)
                {
                    <li>@aviso</li>
                }
            </ul>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-semibold">Recibido</div>
                    <div class="fs-3 fw-bold">@Model.TotalRecibido.FormatoCantidad()</div>
                    <div class="small text-muted">Piezas que bajaron del camión</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-semibold">Aceptado</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalAceptado.FormatoCantidad()</div>
                    <div class="small text-muted">Entró al inventario</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-semibold">Rechazado</div>
                    <div class="fs-3 fw-bold @(Model.TotalRechazado > 0 ? "text-danger" : "")">
                        @Model.TotalRechazado.FormatoCantidad()
                    </div>
                    <div class="small text-muted">La orden lo sigue esperando</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-semibold">Importe</div>
                    <div class="fs-3 fw-bold">@Model.Importe.ToString("C2")</div>
                    <div class="small text-muted">
                        @(string.IsNullOrWhiteSpace(Model.NumeroFactura) ? "Sin factura capturada" : $"Factura {Model.NumeroFactura}")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">Materiales recibidos</h6>
            @if (Model.IdCompra.HasValue)
            {
                <a asp-controller="ComprasEPP" asp-action="Details" asp-route-id="@Model.IdCompra"
                   class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-receipt me-1"></i>Ver la compra que generó
                </a>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Material</th>
                            <th class="text-center">Llegó</th>
                            <th class="text-center">Aceptado</th>
                            <th class="text-end">Pactado</th>
                            <th class="text-end">Pagado</th>
                            <th class="text-end">Importe</th>
                            <th>Lote</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detalles)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">@d.NombreMaterial</div>
                                    @if (!string.IsNullOrWhiteSpace(d.MotivoRechazo))
                                    {
                                        <small class="text-danger">
                                            <i class="bi bi-x-circle me-1"></i>@d.MotivoRechazo
                                        </small>
                                    }
                                </td>
                                <td class="text-center">@d.CantidadRecibida.FormatoCantidad() @d.UnidadMedida</td>
                                <td class="text-center fw-semibold">
                                    @d.CantidadAceptada.FormatoCantidad()
                                    @if (d.CantidadRechazada > 0)
                                    {
                                        <div>
                                            <span class="badge bg-danger-subtle text-danger">
                                                -@d.CantidadRechazada.FormatoCantidad()
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="text-end text-muted">@d.PrecioUnitarioPactado.ToString("C2")</td>
                                <td class="text-end fw-semibold">
                                    @d.PrecioUnitarioReal.ToString("C2")
                                    @if (d.DiferenciaPrecio != 0)
                                    {
                                        <div>
                                            <span class="badge @(d.DiferenciaPrecio > 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">
                                                @d.DiferenciaPrecio.ToString("+0.00;-0.00")
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="text-end">@d.Importe.ToString("C2")</td>
                                <td>
                                    <small class="text-muted">
                                        @if (!string.IsNullOrWhiteSpace(d.Talla))
                                        {
                                            <div>Talla @d.Talla</div>
                                        }
                                        @if (d.FechaCaducidad.HasValue)
                                        {
                                            <div>Caduca @d.FechaCaducidad.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(d.LoteProveedor))
                                        {
                                            <div>Lote prov. @d.LoteProveedor</div>
                                        }
                                        @if (d.IdCompraDetalle.HasValue)
                                        {
                                            <div>Lote #@d.IdCompraDetalle</div>
                                        }
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="small text-muted text-uppercase fw-semibold">Recibió</div>
                    <div>@Model.NombreUsuarioRecibe</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted text-uppercase fw-semibold">Factura</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.NumeroFactura) ? "—" : Model.NumeroFactura)</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted text-uppercase fw-semibold">UUID CFDI</div>
                    <div class="text-break small">@(string.IsNullOrWhiteSpace(Model.UuidCFDI) ? "—" : Model.UuidCFDI)</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted text-uppercase fw-semibold">Observaciones</div>
                    <div class="small">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</div>
                </div>
            </div>
        </div>
    </div>

    @if (Html.PuedeEliminar("RECEPCIONES"))
    {
        <div class="modal fade" id="modalDeshacer" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="Cancelar" asp-route-id="@Model.IdRecepcion" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Deshacer la recepción @Model.Folio
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">
                            Se usa cuando se capturó mal: cantidad equivocada, orden equivocada o
                            material que en realidad no llegó.
                        </p>
                        <ul class="small text-muted ps-3">
                            <li>El material sale del almacén y el kardex conserva el renglón que lo explica.</li>
                            <li>Lo que se había apartado se libera y vuelve a quedar disponible.</li>
                            <li>La orden vuelve a esperar ese material.</li>
                        </ul>
                        <div class="alert alert-warning small mb-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Sólo se puede deshacer la última recepción de esta orden en esta bodega,
                            y sólo si nada de lo que trajo se ha entregado.
                        </div>
                        <label class="form-label fw-semibold">Motivo</label>
                        <textarea name="motivo" class="form-control" rows="2" maxlength="500" required
                                  placeholder="Se capturaron 8 en vez de 5, se recibió contra la orden equivocada..."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Deshacer recepción</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>
