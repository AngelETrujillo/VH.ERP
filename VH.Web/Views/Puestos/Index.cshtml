@using VH.Services.DTOs.Analytics
@model VH.Services.DTOs.ResultadoPaginado<PuestoResponseDto>
@{
    ViewData["Title"] = "Catálogo de Puestos";

    bool? filtroActivo = ViewBag.FiltroActivo;
    ViewData["BuscarPlaceholder"] = "Buscar por nombre o descripción…";

    var filtrosEstado = new Dictionary<string, string?>
    {
        ["activo"] = filtroActivo?.ToString().ToLowerInvariant()
    };
    ViewData["FiltrosPaginador"] = filtrosEstado;
    ViewData["FiltrosOcultos"] = filtrosEstado;

    string LigaEstado(bool? activo)
    {
        var partes = new List<string> { $"tamano={Model.Tamano}" };
        if (activo.HasValue) partes.Add($"activo={activo.Value.ToString().ToLowerInvariant()}");
        if (Model.Buscado != null) partes.Add($"buscar={Uri.EscapeDataString(Model.Buscado)}");
        return "?" + string.Join("&", partes);
    }
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-person-badge text-primary me-2"></i>Catálogo de Puestos
            </h2>
            <p class="text-muted mb-0">Administración de puestos de trabajo para análisis de consumo</p>
        </div>
        @if (Html.PuedeCrear("PUESTOS"))
        {
            <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Puesto
            </a>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-lg-7">
                    @await Html.PartialAsync("_BarraBusqueda", Model)
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="btn-group me-2" role="group" aria-label="Filtrar por estado">
                        <a href="@LigaEstado(null)" class="btn btn-sm @(filtroActivo == null ? "btn-secondary" : "btn-outline-secondary")">Todos</a>
                        <a href="@LigaEstado(true)" class="btn btn-sm @(filtroActivo == true ? "btn-success" : "btn-outline-success")">Activos</a>
                        <a href="@LigaEstado(false)" class="btn btn-sm @(filtroActivo == false ? "btn-danger" : "btn-outline-danger")">Inactivos</a>
                    </div>
                    <span class="badge bg-secondary">@Model.Total puesto(s)</span>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Nivel de Riesgo EPP</th>
                            <th class="text-center">Empleados</th>
                            <th class="text-center">Estado</th>
                            <th width="150"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Vacio)
                        {
                            @foreach (var puesto in Model.Renglones)
                            {
                                <tr>
                                    <td><strong>@puesto.Nombre</strong></td>
                                    <td><small class="text-muted">@(puesto.Descripcion ?? "-")</small></td>
                                    <td class="text-center">
                                        @switch (puesto.NivelRiesgoEPP)
                                        {
                                            case VH.Services.Entities.NivelRiesgoEPP.Alto:
                                                <span class="badge bg-danger">Alto</span>
                                                break;
                                            case VH.Services.Entities.NivelRiesgoEPP.Medio:
                                                <span class="badge bg-warning">Medio</span>
                                                break;
                                            default:
                                                <span class="badge bg-success">Bajo</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@puesto.TotalEmpleados</span>
                                    </td>
                                    <td class="text-center">
                                        @if (puesto.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@puesto.IdPuesto" class="btn btn-outline-secondary" title="Ver">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (Html.PuedeEditar("PUESTOS"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@puesto.IdPuesto" class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (Html.PuedeEliminar("PUESTOS"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@puesto.IdPuesto" class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                    No hay puestos registrados
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Paginador", Model)
        </div>
    </div>
</div>
