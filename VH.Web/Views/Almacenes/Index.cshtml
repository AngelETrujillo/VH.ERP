@model VH.Services.DTOs.ResultadoPaginado<VH.Services.DTOs.AlmacenResponseDto>
@{
    bool? filtroActivo = ViewBag.FiltroActivo;
    ViewData["BuscarPlaceholder"] = "Buscar por nombre, descripción, domicilio u obra…";
    var filtrosEstado = new Dictionary<string, string?>
    {
        ["activo"] = filtroActivo?.ToString().ToLowerInvariant()
    };
    ViewData["FiltrosPaginador"] = filtrosEstado;
    ViewData["FiltrosOcultos"] = filtrosEstado;

    // El estado deja de ser un radio que esconde filas y pasa a ser una liga:
    // filtrando en el navegador, "Inactivos" sólo habría ocultado los activos de
    // la página que estuvieras viendo.
    string LigaEstado(bool? activo)
    {
        var partes = new List<string> { $"tamano={Model.Tamano}" };
        if (activo.HasValue) partes.Add($"activo={activo.Value.ToString().ToLowerInvariant()}");
        if (Model.Buscado != null) partes.Add($"buscar={Uri.EscapeDataString(Model.Buscado)}");
        return "?" + string.Join("&", partes);
    }
}

@{
    ViewData["Title"] = "Almacenes";
    var esSuperAdmin = User.IsInRole("SuperAdmin");
    var puedeCrear = PermisoHelper.PuedeCrear(Context.Session, "EMPLEADOS", esSuperAdmin);
    var puedeEditar = PermisoHelper.PuedeEditar(Context.Session, "EMPLEADOS", esSuperAdmin);
    var puedeEliminar = PermisoHelper.PuedeEliminar(Context.Session, "EMPLEADOS", esSuperAdmin);
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>Gestión de Almacenes
            </h2>
            <p class="text-muted mb-0">Administra los almacenes y bodegas por proyecto</p>
        </div>
        @if (puedeCrear)
        {
            @if (Html.PuedeCrear("ALMACENES"))
            {
                <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Almacén
                </a>
            }
        }
    </div>

    <!-- Alertas -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Card principal -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-lg-7">
                    @await Html.PartialAsync("_BarraBusqueda", Model)
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="btn-group me-2" role="group" aria-label="Filtrar por estado">
                        <a href="@LigaEstado(null)" class="btn btn-sm @(filtroActivo == null ? "btn-secondary" : "btn-outline-secondary")">Todos</a>
                        <a href="@LigaEstado(true)" class="btn btn-sm @(filtroActivo == true ? "btn-success" : "btn-outline-success")">Activos</a>
                        <a href="@LigaEstado(false)" class="btn btn-sm @(filtroActivo == false ? "btn-danger" : "btn-outline-danger")">Inactivos</a>
                    </div>
                    <span class="badge bg-secondary">@Model.Total almacén(es)</span>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Almacén</th>
                            <th>Tipo</th>
                            <th>Proyecto</th>
                            <th>Domicilio</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width:140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Vacio)
                        {
                            @foreach (var item in Model.Renglones)
                            {
                                <tr data-estado="@(item.Activo ? "activo" : "inactivo")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-primary-subtle text-primary me-3">
                                                <i class="bi bi-box-seam"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@item.Nombre</h6>
                                                @if (!string.IsNullOrEmpty(item.Descripcion))
                                                {
                                                    <small class="text-muted">@item.Descripcion.Truncate(30)</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.TipoUbicacion))
                                        {
                                            var badgeClass = item.TipoUbicacion switch
                                            {
                                                "Bodega" => "bg-info-subtle text-info",
                                                "Contenedor" => "bg-warning-subtle text-warning",
                                                "Patio" => "bg-success-subtle text-success",
                                                "Oficina" => "bg-secondary-subtle text-secondary",
                                                _ => "bg-light text-dark"
                                            };
                                            <span class="badge @badgeClass">
                                                <i class="bi bi-geo-alt me-1"></i>@item.TipoUbicacion
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin tipo</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.NombreProyecto))
                                        {
                                            <span class="badge bg-primary-subtle text-primary">
                                                <i class="bi bi-building me-1"></i>@item.NombreProyecto
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Domicilio))
                                        {
                                            <small><i class="bi bi-geo text-muted me-1"></i>@item.Domicilio.Truncate(25)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.IdAlmacen"
                                               class="btn btn-outline-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (puedeEditar)
                                            {
                                                @if (Html.PuedeEditar("ALMACENES"))
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.IdAlmacen"
                                                    class="btn btn-outline-warning" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                    </a>
                                                }
                                            }
                                            @if (puedeEliminar)
                                            {
                                                @if (Html.PuedeEliminar("ALMACENES"))
                                                {
                                                    <a asp-action="Delete" asp-route-id="@item.IdAlmacen"
                                                    class="btn btn-outline-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="text-center py-5">
                                        <i class="bi bi-box-seam display-4 text-muted"></i>
                                        <h5 class="mt-3 text-muted">No hay almacenes registrados</h5>
                                        <p class="text-muted">Comienza creando tu primer almacén</p>
                                        @if (Html.PuedeCrear("ALMACENES"))
                                        {
                                            <a asp-action="Create" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-2"></i>Crear Almacén
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Paginador", Model)
        </div>
    </div>
</div>

<style>
    .icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .table > tbody > tr:hover {
        background-color: #f8f9fa;
    }

    .btn-group-sm > .btn {
        padding: 0.4rem 0.6rem;
    }
</style>

@section Scripts {
    <script>
        // Buscar y filtrar los hace el servidor. Queda sólo devolver el foco al
        // campo, para corregir el texto sin volver a tomar el ratón.
        (function () {
            const campo = document.getElementById('campoBuscar');
            if (campo && campo.value) {
                campo.focus();
                campo.setSelectionRange(campo.value.length, campo.value.length);
            }
        })();
        });
        document.querySelectorAll('input[name="filtroEstado"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const filtro = this.id.replace('filtro', '').toLowerCase();
                document.querySelectorAll('#dataTable tbody tr').forEach(row => {
                    const estado = row.dataset.estado;
                    if (filtro === 'todos') row.style.display = '';
                    else if (filtro === 'activos') row.style.display = estado === 'activo' ? '' : 'none';
                    else if (filtro === 'inactivos') row.style.display = estado === 'inactivo' ? '' : 'none';
                });
            });
        });
    </script>
}