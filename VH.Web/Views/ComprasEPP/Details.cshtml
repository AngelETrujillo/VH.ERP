@model VH.Services.DTOs.CompraEPPResponseDto
@using VH.Web.Extensions
@{
    ViewData["Title"] = $"Compra {(string.IsNullOrEmpty(Model.NumeroDocumento) ? "#" + Model.IdCompra : Model.NumeroDocumento)}";
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-receipt text-primary me-2"></i>
                @(string.IsNullOrEmpty(Model.NumeroDocumento) ? $"Compra #{Model.IdCompra}" : Model.NumeroDocumento)
            </h2>
            <p class="text-muted mb-0">@Model.NombreProveedor · @Model.FechaCompra.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Renglones -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-list-ul me-2"></i>Materiales
                        <span class="badge bg-secondary ms-2">@Model.TotalRenglones</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Material</th>
                                    <th>Almacén</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">P. Unitario</th>
                                    <th class="text-end">Importe</th>
                                    <th class="text-center">Disponible</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Detalles)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-semibold">@d.NombreMaterial</span>
                                            <br />
                                            <small class="text-muted">
                                                @d.UnidadMedidaMaterial
                                                @if (!string.IsNullOrEmpty(d.Talla) && d.Talla != "-")
                                                {
                                                    <span>· Talla @d.Talla</span>
                                                }
                                                @if (d.FechaCaducidad.HasValue)
                                                {
                                                    <span class="@(d.EstaCaducado ? "text-danger fw-semibold" : "")">
                                                        · Caduca @d.FechaCaducidad.Value.ToString("dd/MM/yyyy")
                                                    </span>
                                                }
                                            </small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info">
                                                <i class="bi bi-box-seam me-1"></i>@d.NombreAlmacen
                                            </span>
                                        </td>
                                        <td class="text-center fw-semibold">@d.Cantidad.FormatoCantidad()</td>
                                        <td class="text-end">@d.PrecioUnitario.ToString("C2")</td>
                                        <td class="text-end fw-semibold">@d.CostoTotal.ToString("C2")</td>
                                        <td class="text-center">
                                            @if (d.CantidadDisponible > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    @d.CantidadDisponible.FormatoCantidad()
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Agotado</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Documento -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-file-earmark-text me-2"></i>Documento</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-muted fw-normal">Proveedor</dt>
                        <dd class="col-7">@Model.NombreProveedor</dd>

                        <dt class="col-5 text-muted fw-normal">Fecha</dt>
                        <dd class="col-7">@Model.FechaCompra.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-5 text-muted fw-normal">Factura</dt>
                        <dd class="col-7">@(string.IsNullOrEmpty(Model.NumeroDocumento) ? "—" : Model.NumeroDocumento)</dd>

                        <dt class="col-5 text-muted fw-normal">UUID CFDI</dt>
                        <dd class="col-7"><small class="font-monospace">@(string.IsNullOrEmpty(Model.UuidCFDI) ? "—" : Model.UuidCFDI)</small></dd>

                        @if (!string.IsNullOrEmpty(Model.Observaciones))
                        {
                            <dt class="col-5 text-muted fw-normal">Notas</dt>
                            <dd class="col-7">@Model.Observaciones</dd>
                        }
                    </dl>
                </div>
            </div>

            <!-- Importes -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold">@Model.Subtotal.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">IVA</span>
                        <span class="fw-semibold">@Model.Iva.ToString("C2")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5 text-success">@Model.Total.ToString("C2")</span>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a asp-action="Edit" asp-route-id="@Model.IdCompra" class="btn btn-warning">
                    <i class="bi bi-pencil me-2"></i>Editar documento
                </a>
                @if (Model.PuedeCancelarse)
                {
                    <a asp-action="Delete" asp-route-id="@Model.IdCompra" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-2"></i>Cancelar compra
                    </a>
                }
                else
                {
                    <div class="alert alert-secondary small mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        No se puede cancelar: ya se entregó material de esta compra.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
