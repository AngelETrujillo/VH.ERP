@model VH.Services.DTOs.InventarioListadoDto
@{
    var pagina = Model.Renglones;
    string? filtroEstado = ViewBag.FiltroEstado;
    ViewData["BuscarPlaceholder"] = "Buscar por material, almacén o ubicación…";

    var filtrosInv = new Dictionary<string, string?>
    {
        ["estado"]     = filtroEstado,
        ["idAlmacen"]  = ViewBag.FiltroAlmacen?.ToString()
    };
    ViewData["FiltrosPaginador"] = filtrosInv;
    ViewData["FiltrosOcultos"] = filtrosInv;

    string LigaEstado(string? estado)
    {
        var partes = new List<string> { $"tamano={pagina.Tamano}" };
        if (!string.IsNullOrWhiteSpace(estado)) partes.Add($"estado={estado}");
        if (pagina.Buscado != null) partes.Add($"buscar={Uri.EscapeDataString(pagina.Buscado)}");
        if (ViewBag.FiltroAlmacen != null) partes.Add($"idAlmacen={ViewBag.FiltroAlmacen}");
        return "?" + string.Join("&", partes);
    }
}
@{
    ViewData["Title"] = "Inventarios";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-boxes text-primary me-2"></i>Control de Inventarios
            </h2>
            <p class="text-muted mb-0">Existencias de materiales EPP por almacén</p>
        </div>
        @if (Html.PuedeCrear("INVENTARIOS"))
        {
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Nuevo Registro
            </a>
        }
    </div>

    <!-- Alertas -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Los conteos son de todo el inventario, no de la página: con paginación,
       "3 materiales sin stock" contado sobre lo cargado habría sido "3 de los
       veinticinco que alcanzas a ver". *@
    @if (Model.SinStock > 0 || Model.StockBajo > 0 || Model.SobreMaximo > 0 || Model.SinMinimo > 0)
    {
        <div class="row g-3 mb-4">
            @if (Model.SinStock > 0)
            {
                <div class="col-md-3">
                    <a href="@LigaEstado("sin")" class="text-decoration-none">
                        <div class="alert alert-danger mb-0 d-flex align-items-center @(filtroEstado == "sin" ? "border border-2 border-danger" : "")">
                            <i class="bi bi-x-circle-fill fs-4 me-3"></i>
                            <div><strong>@Model.SinStock</strong> sin stock</div>
                        </div>
                    </a>
                </div>
            }
            @if (Model.StockBajo > 0)
            {
                <div class="col-md-3">
                    <a href="@LigaEstado("bajo")" class="text-decoration-none">
                        <div class="alert alert-warning mb-0 d-flex align-items-center @(filtroEstado == "bajo" ? "border border-2 border-warning" : "")">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div><strong>@Model.StockBajo</strong> con stock bajo</div>
                        </div>
                    </a>
                </div>
            }
            @if (Model.SobreMaximo > 0)
            {
                <div class="col-md-3">
                    <a href="@LigaEstado("sobre")" class="text-decoration-none">
                        <div class="alert alert-info mb-0 d-flex align-items-center @(filtroEstado == "sobre" ? "border border-2 border-info" : "")">
                            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                            <div><strong>@Model.SobreMaximo</strong> sobre el máximo</div>
                        </div>
                    </a>
                </div>
            }
            @if (Model.SinMinimo > 0)
            {
                <div class="col-md-3">
                    <div class="alert alert-secondary mb-0 d-flex align-items-center">
                        <i class="bi bi-eye-slash fs-4 me-3"></i>
                        <div><strong>@Model.SinMinimo</strong> sin mínimo definido</div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Card principal -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-lg-7">
                    @await Html.PartialAsync("_BarraBusqueda", pagina)
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="btn-group me-2" role="group" aria-label="Filtrar por estado de stock">
                        <a href="@LigaEstado(null)" class="btn btn-sm @(filtroEstado == null ? "btn-secondary" : "btn-outline-secondary")">Todos</a>
                        <a href="@LigaEstado("bajo")" class="btn btn-sm @(filtroEstado == "bajo" ? "btn-warning" : "btn-outline-warning")">Stock bajo</a>
                        <a href="@LigaEstado("sin")" class="btn btn-sm @(filtroEstado == "sin" ? "btn-danger" : "btn-outline-danger")">Sin stock</a>
                    </div>
                    <span class="badge bg-secondary">@pagina.Total registro(s)</span>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Material</th>
                            <th>Almacén</th>
                            <th class="text-center">Existencia</th>
                            <th class="text-center">Apartado</th>
                            <th class="text-center">Disponible</th>
                            <th class="text-center">Mínimo</th>
                            <th class="text-center">Máximo</th>
                            <th class="text-center">Estado</th>
                            <th>Ubicación</th>
                            <th class="text-center" style="width:140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!pagina.Vacio)
                        {
                            @foreach (var item in pagina.Renglones)
                            {
                                var estadoStock = "normal";
                                var badgeClass = "bg-success-subtle text-success";
                                var estadoTexto = "Normal";
                                var estadoIcono = "bi-check-circle";

                                if (item.Existencia == 0)
                                {
                                    estadoStock = "sinstock";
                                    badgeClass = "bg-danger-subtle text-danger";
                                    estadoTexto = "Sin Stock";
                                    estadoIcono = "bi-x-circle";
                                }
                                else if (item.Existencia <= item.StockMinimo)
                                {
                                    estadoStock = "bajo";
                                    badgeClass = "bg-warning-subtle text-warning";
                                    estadoTexto = "Stock Bajo";
                                    estadoIcono = "bi-exclamation-triangle";
                                }
                                else if (item.StockMaximo > 0 && item.Existencia > item.StockMaximo)
                                {
                                    estadoStock = "alto";
                                    badgeClass = "bg-info-subtle text-info";
                                    estadoTexto = "Excedido";
                                    estadoIcono = "bi-arrow-up-circle";
                                }

                                <tr data-estado="@estadoStock">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-primary-subtle text-primary me-3">
                                                <i class="bi bi-shield-check"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@item.NombreMaterial</h6>
                                                <small class="text-muted">@item.UnidadMedidaMaterial</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info">
                                            <i class="bi bi-box-seam me-1"></i>@item.NombreAlmacen
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fs-5 fw-bold @(item.Existencia == 0 ? "text-danger" : item.Existencia <= item.StockMinimo ? "text-warning" : "text-success")">
                                            @item.Existencia.FormatoCantidad()
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Comprometido > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning" title="Apartado para requisiciones autorizadas">
                                                <i class="bi bi-lock me-1"></i>@item.Comprometido.FormatoCantidad()
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-semibold @(item.Disponible <= 0 ? "text-danger" : "")">
                                            @item.Disponible.FormatoCantidad()
                                        </span>
                                    </td>
                                    <td class="text-center text-muted">@item.StockMinimo.FormatoCantidad()</td>
                                    <td class="text-center text-muted">@(item.StockMaximo > 0 ? item.StockMaximo.FormatoCantidad() : "-")</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass px-3 py-2">
                                            <i class="bi @estadoIcono me-1"></i>@estadoTexto
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.UbicacionPasillo))
                                        {
                                            <small><i class="bi bi-geo-alt text-muted me-1"></i>@item.UbicacionPasillo</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.IdInventario"
                                               class="btn btn-outline-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (Html.PuedeEditar("INVENTARIOS"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.IdInventario"
                                                class="btn btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (Html.PuedeEliminar("INVENTARIOS"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.IdInventario"
                                                class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="text-center py-5">
                                        <i class="bi bi-boxes display-4 text-muted"></i>
                                        <h5 class="mt-3 text-muted">No hay registros de inventario</h5>
                                        <p class="text-muted">El inventario se crea automáticamente con las compras</p>
                                        @if (Html.PuedeCrear("INVENTARIOS"))
                                        {
                                            <a asp-action="Create" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-2"></i>Crear Registro
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Paginador", pagina)
        </div>
    </div>
</div>

<style>
    .icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .table > tbody > tr:hover {
        background-color: #f8f9fa;
    }

    .btn-group-sm > .btn {
        padding: 0.4rem 0.6rem;
    }
</style>

@section Scripts {
    <script>
        // Buscar y filtrar los hace el servidor.
        (function () {
            const campo = document.getElementById('campoBuscar');
            if (campo && campo.value) {
                campo.focus();
                campo.setSelectionRange(campo.value.length, campo.value.length);
            }
        })();
        });
        document.querySelectorAll('input[name="filtroStock"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const filtro = this.id.replace('filtro', '').toLowerCase();
                document.querySelectorAll('#dataTable tbody tr').forEach(row => {
                    const estado = row.dataset.estado;
                    if (filtro === 'todos') row.style.display = '';
                    else if (filtro === 'bajo') row.style.display = (estado === 'bajo' || estado === 'sinstock') ? '' : 'none';
                    else if (filtro === 'sinstock') row.style.display = estado === 'sinstock' ? '' : 'none';
                });
            });
        });
    </script>
}