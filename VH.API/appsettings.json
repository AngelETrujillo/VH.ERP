{
  // Jwt:Key NO va aquí: es un secreto y este archivo está versionado.
  // En desarrollo se configura con user-secrets:
  //     dotnet user-secrets set "Jwt:Key" "<cadena aleatoria de 32+ caracteres>"
  // En servidor, con la variable de entorno Jwt__Key.
  "Jwt": {
    "Issuer": "VHERP.API",
    "Audience": "VHERP.Client",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Sólo desarrollo local con LocalDB y autenticación integrada: sin usuario ni
  // contraseña, así que no es un secreto. Cualquier cadena con credenciales va en
  // user-secrets o en la variable ConnectionStrings__DefaultConnection, nunca aquí.
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=VHERP_DB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AllowedHosts": "*"
}
